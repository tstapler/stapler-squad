load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "reporoot",
    srcs = ["reporoot.go"],
    importpath = "github.com/tstapler/stapler-squad/internal/reporoot",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":reporoot",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "reporoot_test",
    srcs = ["reporoot_test.go"],
    data = ["//:go.mod"],
    embed = [":reporoot"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
