load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "parser",
    srcs = [
        "bash.go",
        "zsh.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/internal/parser",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/history"],
)

alias(
    name = "go_default_library",
    actual = ":parser",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "parser_test",
    srcs = [
        "bash_test.go",
        "zsh_test.go",
    ],
    embed = [":parser"],
)
