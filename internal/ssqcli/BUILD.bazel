load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "ssqcli",
    srcs = [
        "aliases.go",
        "client.go",
        "command.go",
        "spec.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/internal/ssqcli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//pkg/localtoken",
        "//proto/session/v1:sessionv1_go",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@org_golang_google_protobuf//types/dynamicpb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":ssqcli",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "ssqcli_test",
    srcs = ["ssqcli_test.go"],
    embed = [":ssqcli"],
    deps = [
        "//pkg/localtoken",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
