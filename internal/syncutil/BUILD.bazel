load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "syncutil",
    srcs = ["syncutil.go"],
    importpath = "github.com/tstapler/stapler-squad/internal/syncutil",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":syncutil",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "syncutil_test",
    srcs = ["syncutil_test.go"],
    embed = [":syncutil"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
