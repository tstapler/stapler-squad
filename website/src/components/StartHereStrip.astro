---
// "Start here" cards: the built tours with tour.order 1-3, derived and never hard-coded
// (Cross-cutting 6e). Used on /tours/ and on the landing page; renders nothing when none is built.
import { clipDurationMs, formatWatch } from '../lib/tours/manifest';
import { startHere } from '../lib/tours/nav';
import type { TourEntry } from '../lib/tours/schema';
import { basePath, builtTours, tourContext } from '../lib/tours/site';

export interface Props {
	/** Unique per page, so the landing page and /tours/ can each label their region. */
	headingId: string;
}
const { headingId } = Astro.props;

const strip = startHere(await builtTours());
const { manifest } = tourContext();
const base = basePath();
const watch = (t: TourEntry) => formatWatch(clipDurationMs(manifest, t.tour.clip));
---

{
	strip.length > 0 && (
		<section class="tour-start" aria-labelledby={headingId} data-testid="tour-start-here">
			<h2 id={headingId}>Start here</h2>
			<ul class="tour-cards">
				{strip.map((t) => (
					<li class="tour-card" data-testid="tour-card">
						<h3>{t.tour.title}</h3>
						<p>{t.tour.outcome}</p>
						{watch(t) && <p class="tour-card-meta">Watch {watch(t)}</p>}
						<a class="tour-link" href={`${base}/${t.id}/`}>See the tour: {t.tour.title}</a>
					</li>
				))}
			</ul>
		</section>
	)
}
