---
// Server-rendered markup intentionally never sets `autoplay` -- an Astro
// component renders server-side with no access to the client's media-query
// preference (design/ux.md §1.4's reduced-motion edge case). The inline
// script below adds `autoplay` only once it has checked
// `prefers-reduced-motion` client-side, so a no-JS visitor or one who
// prefers reduced motion never gets forced motion; both still get the
// `poster` frame and visible native controls.
export interface Props {
	src: string;
	poster: string;
}

const { src, poster } = Astro.props;
---

<video data-testid="hero-video" loop muted controls poster={poster} src={src}>
	Your browser doesn't support embedded video. <a href={src}>Download the demo</a>.
</video>

<script>
	import { initHeroVideos } from '../lib/reduced-motion-video';
	initHeroVideos();
</script>

<style>
	video[data-testid='hero-video'] {
		width: 100%;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 0.75rem;
		margin: 1.5rem 0;
	}
</style>
