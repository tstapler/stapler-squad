---
// Renders website/src/content/features.json's FeatureCard entries,
// grouped by README's 5 Highlights categories (design/ux.md §1's wireframe:
// "grouped by the 5 README categories"), in a responsive grid that collapses
// to a single column at phone width (no horizontal scroll).
import FeatureCard from './FeatureCard.astro';
import features from '../content/features.json';
import { CATEGORY_ORDER } from '../../scripts/build-features.mjs';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { PUBLIC_DIR, basePath, builtTours } from '../lib/tours/site';

// features.json declares clips by name (Story 3.1.2), so it is identical in git
// and in the deployed build. Rendering is where file presence matters: a card
// whose clip file is not in public/clips (a PR smoke build, a local build) shows
// its screenshot instead of a dead <video>. A missing clip in a deploy is caught
// by the freshness gate (mediatool fresh), not here.
// PUBLIC_DIR, not a URL relative to this file: import.meta.url points into the build output here.
const clipPresent = (clip?: { name: string; ext: string }) =>
	clip ? existsSync(join(PUBLIC_DIR, 'clips', `${clip.name}.${clip.ext}`)) : false;

// Same idea for stills: a card shows its recorded shot (public/shots/<name>.webp), else the
// legacy committed screenshot (public/features/<name>.png, retired in Phase 5), else no image.
const shotFor = (screenshot?: string) => {
	if (!screenshot) return undefined;
	if (existsSync(join(PUBLIC_DIR, screenshot.slice(1)))) return screenshot;
	const legacy = `/features/${screenshot.replace(/^\/shots\//, '').replace(/\.webp$/, '.png')}`;
	return existsSync(join(PUBLIC_DIR, legacy.slice(1))) ? legacy : undefined;
};

// "See the tour" only for tours that are built, so smoke builds never link to an unbuilt page.
const tours = new Map((await builtTours()).map((t) => [t.id.replace(/^tours\//, ''), t]));
const tourFor = (card: { tour?: string }) => {
	const t = card.tour ? tours.get(card.tour) : undefined;
	return t ? { title: t.tour.title, href: `${basePath()}/${t.id}/` } : undefined;
};

const groups = CATEGORY_ORDER.map((category) => ({
	category,
	cards: features.filter((card) => card.category === category),
})).filter((group) => group.cards.length > 0);
---

<section class="feature-grid-section" data-testid="feature-grid">
	{
		groups.map(({ category, cards }) => (
			<div class="feature-category">
				<h3 class="feature-category-heading">{category}</h3>
				<div class="feature-grid">
					{cards.map((card) => (
						<FeatureCard
							heading={card.heading}
							description={card.description}
							category={card.category}
							screenshot={shotFor(card.screenshot)}
							alt={card.alt}
							tour={tourFor(card)}
							demoClip={clipPresent(card.demoClip) ? card.demoClip : undefined}
						/>
					))}
				</div>
			</div>
		))
	}
</section>

<style>
	.feature-grid-section {
		overflow-x: hidden;
		max-width: 100%;
	}

	.feature-category {
		margin-top: 2rem;
	}

	.feature-category-heading {
		margin-bottom: 1rem;
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
		max-width: 100%;
	}

	/* Explicit single-column fallback at phone width (375px-class viewports),
	   rather than relying only on auto-fit's implicit collapse. */
	@media (max-width: 480px) {
		.feature-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
