---
// Renders the install command as a plain, always-selectable <pre><code> block
// plus a progressive-enhancement copy button. The command text itself is
// never gated behind JS (design/ux.md §1.4's "Clipboard API blocked" state):
// a visitor with JS disabled or the Clipboard API denied can still
// triple-click-select and copy manually.
export interface Props {
	command: string;
}

const { command } = Astro.props;
---

<div class="install-command">
	<pre><code data-testid="install-command-text">{command}</code></pre>
	<button type="button" class="copy-button" data-testid="install-copy-button" aria-label="Copy install command">
		<span class="copy-icon" aria-hidden="true">📋</span>
		<span class="copy-label" data-default-label="Copy" data-copied-label="Copied ✓">Copy</span>
	</button>
</div>

<script>
	// Progressive enhancement only -- see the component comment above for the
	// no-JS/Clipboard-blocked fallback this degrades to.
	document.querySelectorAll<HTMLButtonElement>('[data-testid="install-copy-button"]').forEach((button) => {
		button.addEventListener('click', async () => {
			const block = button.closest('.install-command');
			const codeEl = block?.querySelector('[data-testid="install-command-text"]');
			const text = codeEl?.textContent ?? '';
			const label = button.querySelector<HTMLSpanElement>('.copy-label');
			try {
				await navigator.clipboard.writeText(text);
				if (label) {
					const defaultLabel = label.dataset.defaultLabel ?? 'Copy';
					const copiedLabel = label.dataset.copiedLabel ?? 'Copied ✓';
					label.textContent = copiedLabel;
					setTimeout(() => {
						label.textContent = defaultLabel;
					}, 2000);
				}
			} catch {
				// Clipboard API blocked (insecure context, permission denied, or
				// unavailable) -- the command text above remains plain and
				// selectable, so the user can still copy manually.
			}
		});
	});
</script>

<style>
	.install-command {
		display: flex;
		align-items: stretch;
		gap: 0.5rem;
		max-width: 100%;
		margin: 1.5rem 0;
	}

	.install-command pre {
		flex: 1;
		min-width: 0;
		margin: 0;
		overflow-x: auto;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		background: var(--sl-color-gray-6, #1b1b1f);
		color: var(--sl-color-white, #fff);
		font-size: var(--sl-text-sm, 0.875rem);
	}

	.install-command code {
		white-space: pre;
	}

	.copy-button {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0 0.875rem;
		min-height: 48px;
		min-width: 48px;
		border: 1px solid var(--sl-color-gray-5, #3b3b43);
		border-radius: 0.5rem;
		background: var(--sl-color-bg, #17171c);
		color: var(--sl-color-white, #fff);
		cursor: pointer;
		font-size: var(--sl-text-sm, 0.875rem);
	}

	.copy-button:hover {
		background: var(--sl-color-gray-6, #1b1b1f);
	}

	.copy-button:focus-visible {
		outline: 2px solid var(--sl-color-accent, #8b5cf6);
		outline-offset: 2px;
	}

	@media (max-width: 480px) {
		.install-command {
			flex-direction: column;
		}

		.copy-button {
			justify-content: center;
			width: 100%;
		}
	}
</style>
