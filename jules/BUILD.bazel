load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "jules",
    srcs = [
        "client.go",
        "errors.go",
        "keychain.go",
        "rate_limit.go",
        "source_registry.go",
        "types.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/jules",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "@com_github_zalando_go_keyring//:go-keyring",
        "@org_golang_x_sync//singleflight",
    ],
)

alias(
    name = "go_default_library",
    actual = ":jules",
    visibility = ["//visibility:public"],
)

go_test(
    name = "jules_test",
    srcs = [
        "client_test.go",
        "errors_test.go",
        "golden_test.go",
        "keychain_test.go",
        "secrets_guard_test.go",
        "source_registry_test.go",
        "types_test.go",
    ],
    embed = [":jules"],
    tags = ["manual"],  # keep
    deps = [
        "//executor/safeexec",
        "//log",
        "//testutil/wait",
        "@com_github_zalando_go_keyring//:go-keyring",
    ],
)
