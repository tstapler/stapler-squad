# Bazel is used only for third_party/ghostty (own ghostty-vt.wasm build). See ADR-039.
common --enable_bzlmod
build --incompatible_strict_action_env
build --remote_cache_compression

# Remote cache is opt-in; the action inputs are all sha256-pinned so cache hits are sound:
#   bazel build --remote_cache=grpcs://<host> //third_party/ghostty:ghostty_vt_wasm
# Per-machine overrides (cache endpoint, credentials) go in the gitignored .bazelrc.user.
try-import %workspace%/.bazelrc.user
