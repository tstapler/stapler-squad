# gazelle:ignore
load("@bazel_lib//lib:copy_directory.bzl", "copy_directory")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# Spike S3 (Story 0.5): dist/ comes from another package's tree artifact and is staged at the
# exact relative path embed.go names (ADR-007). No Go source change.
copy_directory(
    name = "dist_staged",
    src = "//web-app:dist",
    out = "dist",
)

go_library(
    name = "web",
    srcs = ["embed.go"],
    embedsrcs = [":dist_staged"],
    importpath = "github.com/tstapler/stapler-squad/server/web",
    visibility = ["//visibility:public"],
)

go_test(
    name = "web_test",
    srcs = ["embed_spike_test.go"],
    deps = [":web"],
)

exports_files(["embed.go", "embed_spike_test.go"], visibility = ["//server/web/fixture:__pkg__"])
