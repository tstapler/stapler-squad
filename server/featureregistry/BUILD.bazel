load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "featureregistry",
    srcs = ["registry.go"],
    importpath = "github.com/tstapler/stapler-squad/server/featureregistry",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":featureregistry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "featureregistry_test",
    srcs = [
        "export_test.go",
        "registry_test.go",
    ],
    embed = [":featureregistry"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
