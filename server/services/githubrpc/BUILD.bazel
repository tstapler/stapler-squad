load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "githubrpc",
    srcs = [
        "github_service.go",
        "github_user_actions.go",
        "github_user_nudge.go",
        "github_user_service.go",
        "wiring.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/githubrpc",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//github",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/services/access",
        "//server/services/prs",
        "//session",
        "//session/domain",
        "//session/instance",
        "//session/markerstore",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":githubrpc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "githubrpc_test",
    srcs = [
        "fixtures_test.go",
        "github_golden_test.go",
        "github_service_merge_method_test.go",
        "github_service_pr_target_test.go",
        "github_service_test.go",
        "github_user_actions_test.go",
        "github_user_nudge_funnel_test.go",
        "github_user_nudge_latency_test.go",
        "github_user_nudge_test.go",
        "github_user_service_test.go",
        "testmain_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":githubrpc"],
    deps = [
        "//github",
        "//proto/session/v1:sessionv1_go",
        "//server/services/access",
        "//server/services/internal/svctest",
        "//server/services/prs",
        "//session/domain",
        "//session/instance",
        "//session/markerstore",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@com_github_zalando_go_keyring//:go-keyring",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
