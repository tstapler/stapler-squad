load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "workspacedb",
    srcs = ["database_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/workspacedb",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//internal/sqlitedsn",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/services/fsops",
        "//session/dbpool",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_modernc_sqlite//:sqlite",
    ],
)

alias(
    name = "go_default_library",
    actual = ":workspacedb",
    visibility = ["//visibility:public"],
)

go_test(
    name = "workspacedb_test",
    srcs = [
        "database_service_merge_backlog_test.go",
        "database_service_test.go",
        "testmain_test.go",
    ],
    embed = [":workspacedb"],
    deps = [
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/services/backlogmisc",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
