load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "itemsessions",
    srcs = [
        "item_session_uuids.go",
        "rounds.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/itemsessions",
    visibility = ["//visibility:public"],
    deps = [
        "//session/domain/backlogdto",
        "//session/instance",
    ],
)

alias(
    name = "go_default_library",
    actual = ":itemsessions",
    visibility = ["//visibility:public"],
)

go_test(
    name = "itemsessions_test",
    srcs = ["item_session_uuids_test.go"],
    embed = [":itemsessions"],
    deps = [
        "//session/domain/backlogdto",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
