load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "sessiondefaults",
    srcs = [
        "defaults_service.go",
        "launcher_presets_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/sessiondefaults",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//config/clihelp",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//session/domain",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sessiondefaults",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sessiondefaults_test",
    srcs = [
        "defaults_service_probe_test.go",
        "defaults_service_test.go",
        "launcher_presets_service_test.go",
        "testmain_test.go",
    ],
    data = [
        "defaults_service_test.go",
        "//config/clihelp:testdata",
    ],
    embed = [":sessiondefaults"],
    deps = [
        "//config",
        "//config/clihelp",
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_goleak//:goleak",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
