        "notification_actions.go",
        "notification_priority.go",
        "notification_prune.go",
        "notification_service.go",
        "notification_text.go",
        "rate_limiter.go",
        "slack_config_service.go",
        "slack_interactive_handler.go",
        "slack_notifier.go",
        "slack_signature.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/notify",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/deliverygate",
        "//server/events",
        "//server/notifications",
        "//server/services/access",
        "//server/services/approvalkit",
        "//server/services/auditkit",
