load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "credkit",
    srcs = [
        "credentials.go",
        "provider_limits.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/credkit",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//jules",
        "//log",
    ],
)

alias(
    name = "go_default_library",
    actual = ":credkit",
    visibility = ["//visibility:public"],
)

go_test(
    name = "credkit_test",
    srcs = [
        "credential_edge_test.go",
        "credential_sources_test.go",
        "credentials_test.go",
    ],
    embed = [":credkit"],
    deps = [
        "//config",
        "//jules",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
