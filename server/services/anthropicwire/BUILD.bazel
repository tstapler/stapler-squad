load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "anthropicwire",
    srcs = [
        "ai_interfaces.go",
        "anthropic_client.go",
        "anthropic_limits_client.go",
        "cli_ai_client.go",
        "gemini_limits_client.go",
        "selecting_ai_client.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/anthropicwire",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//executor",
        "//executor/safeexec",
        "//log",
        "//server/services/credkit",
        "//session/domain",
        "//session/headless",
    ],
)

alias(
    name = "go_default_library",
    actual = ":anthropicwire",
    visibility = ["//visibility:public"],
)

go_test(
    name = "anthropicwire_test",
    srcs = [
        "anthropic_backend_url_test.go",
        "anthropic_client_test.go",
        "cli_ai_client_test.go",
        "wire_test.go",
    ],
    embed = [":anthropicwire"],
    deps = [
        "//config",
        "//server/services/credkit",
        "//server/services/internal/svctest",
        "//session/headless",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
