load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "hookinstall",
    srcs = ["service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/hookinstall",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//internal/claudehooks",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":hookinstall",
    visibility = ["//visibility:public"],
)

go_test(
    name = "hookinstall_test",
    srcs = [
        "service_test.go",
        "testmain_test.go",
    ],
    embed = [":hookinstall"],
    deps = [
        "//internal/claudehooks",
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "@com_connectrpc_connect//:connect",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
