load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "artifactrpc",
    srcs = [
        "artifact_browse.go",
        "artifact_search.go",
        "artifact_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/artifactrpc",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/adapters",
        "//server/services/prs",
        "//server/services/searchrpc",
        "//session/artifacts",
        "//session/domain",
        "//session/instance",
        "//session/search",
        "//telemetry",
        "@com_connectrpc_connect//:connect",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":artifactrpc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "artifactrpc_test",
    srcs = [
        "artifact_browse_test.go",
        "artifact_search_test.go",
        "artifact_service_test.go",
        "testmain_test.go",
    ],
    embed = [":artifactrpc"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "//server/services/searchrpc",
        "//session/artifacts",
        "//session/domain",
        "//session/instance",
        "//session/search",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
