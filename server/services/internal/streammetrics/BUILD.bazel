load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "streammetrics",
    srcs = [
        "must.go",
        "watch_stream_metrics.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/internal/streammetrics",
    visibility = ["//server/services:__subpackages__"],
    deps = [
        "//log",
        "//telemetry",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

alias(
    name = "go_default_library",
    actual = ":streammetrics",
    visibility = ["//server/services:__subpackages__"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
