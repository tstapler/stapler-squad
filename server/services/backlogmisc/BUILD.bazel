load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "backlogmisc",
    srcs = [
        "backlog_debug_mutate_handler.go",
        "backlog_item_event_publisher.go",
        "headless_service.go",
        "llm_backend_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/backlogmisc",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/events",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/headless",
        "//session/instance",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":backlogmisc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "backlogmisc_test",
    srcs = [
        "backlog_item_event_publisher_test.go",
        "backlogmisc_golden_test.go",
        "backlogmisc_pins_test.go",
        "headless_service_test.go",
        "llm_backend_service_test.go",
    ],
    data = glob(["testdata/**"]) + ["//session/domain/backlogdto:go_sources"],
    embed = [":backlogmisc"],
    deps = [
        "//config",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/events",
        "//server/services/anthropicwire",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/headless",
        "//session/instance",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
