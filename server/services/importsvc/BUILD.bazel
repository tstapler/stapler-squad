load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "importsvc",
    srcs = ["import_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/importsvc",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//session",
        "//session/historyadapters",
        "//session/importer",
        "//session/instance",
        "//session/procinfo",
        "//session/registry",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":importsvc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "importsvc_test",
    srcs = ["import_service_test.go"],
    embed = [":importsvc"],
    deps = [
        "//executor/safeexec",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/interceptors",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/importer",
        "//session/instance",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
