load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "errorregistry",
    srcs = ["error_registry.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/errorregistry",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//tools/bzl/ent",
        "//tools/bzl/ent:errorevent",
    ],
)

alias(
    name = "go_default_library",
    actual = ":errorregistry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "errorregistry_test",
    srcs = [
        "error_registry_test.go",
        "testmain_test.go",
    ],
    embed = [":errorregistry"],
    deps = [
        "//server/services/internal/svctest",
        "//session",
        "//tools/bzl/ent",
        "//tools/bzl/ent:errorevent",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
