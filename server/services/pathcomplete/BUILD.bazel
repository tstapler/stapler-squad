load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "pathcomplete",
    srcs = ["path_completion_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/pathcomplete",
    visibility = ["//visibility:public"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/fsops",
        "//session/git/backend",
        "//session/gitprovider",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":pathcomplete",
    visibility = ["//visibility:public"],
)

go_test(
    name = "pathcomplete_test",
    srcs = [
        "path_completion_service_test.go",
        "testmain_test.go",
        "worktree_entries_test.go",
    ],
    embed = [":pathcomplete"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "//session/git/backend",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
