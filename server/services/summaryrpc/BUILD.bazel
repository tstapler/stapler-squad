load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "summaryrpc",
    srcs = [
        "handoff_summary_service.go",
        "session_summary_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/summaryrpc",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//session/domain",
        "//session/instance",
        "//session/summaries",
        "//tools/bzl/ent",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":summaryrpc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "summaryrpc_test",
    srcs = [
        "handoff_summary_service_test.go",
        "session_summary_service_test.go",
        "summaryrpc_golden_test.go",
        "summaryrpc_mapping_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":summaryrpc"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/git",
        "//session/headless",
        "//session/instance",
        "//session/summaries",
        "//testutil/wait",
        "//tools/bzl/ent",
        "//tools/bzl/ent:handoffsummary",
        "//tools/bzl/ent:sessionsummary",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
