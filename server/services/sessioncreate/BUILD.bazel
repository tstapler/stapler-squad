        "stale_creation_sweeper_test.go",
        "terminal_write_test.go",
        "testmain_test.go",
        "tilde_test.go",
    ],
    # spawn_test.go and pipeline_wiring_test.go parse the package sources.
    data = glob(["*.go"]),
    embed = [":sessioncreate"],
    deps = [
        "//config",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/internal/svctest",
        "//session",
        "//session/detection",
