load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "quota",
    srcs = [
        "quota_gate.go",
        "quota_headroom.go",
        "quota_settings_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/quota",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/events",
        "//server/services/featureflags",
        "//session/domain",
        "//session/instance",
        "//session/tokens",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":quota",
    visibility = ["//visibility:public"],
)

go_test(
    name = "quota_test",
    srcs = [
        "config_surface_proof_quota_test.go",
        "quota_boundary_test.go",
        "quota_gate_test.go",
        "quota_golden_helper_test.go",
        "quota_golden_test.go",
        "quota_headroom_test.go",
        "quota_settings_service_test.go",
        "quota_settings_w21a_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":quota"],
    deps = [
        "//config",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/events",
        "//server/services/featureflags",
        "//server/services/internal/svctest",
        "//session/domain",
        "//session/instance",
        "//session/tokens",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//proto",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
