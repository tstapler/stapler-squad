load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "secretscan",
    srcs = [
        "redaction_sentinels.go",
        "secret_scanner.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/secretscan",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":secretscan",
    visibility = ["//visibility:public"],
)

go_test(
    name = "secretscan_test",
    srcs = [
        "redaction_sentinels_test.go",
        "secret_scanner_test.go",
    ],
    embed = [":secretscan"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
