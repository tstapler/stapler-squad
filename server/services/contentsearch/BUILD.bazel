load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "contentsearch",
    srcs = [
        "content_search.go",
        "content_search_handler.go",
        "content_search_ignore.go",
        "content_search_limits.go",
        "content_search_match.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/contentsearch",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/services/fsops",
        "@com_connectrpc_connect//:connect",
        "@com_github_bmatcuk_doublestar_v4//:doublestar",
        "@com_github_go_git_go_git_v5//plumbing/format/gitignore",
        "@org_golang_x_sync//errgroup",
    ],
)

alias(
    name = "go_default_library",
    actual = ":contentsearch",
    visibility = ["//visibility:public"],
)

go_test(
    name = "contentsearch_test",
    srcs = [
        "content_search_bench_test.go",
        "content_search_fixture_test.go",
        "content_search_handler_test.go",
        "content_search_test.go",
    ],
    embed = [":contentsearch"],
    deps = [
        "//executor/safeexec",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/services/fsops",
        "//session/domain",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_uber_go_goleak//:goleak",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
