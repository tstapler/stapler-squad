load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "searchrpc",
    srcs = [
        "artifact_search_metrics.go",
        "local_file_service.go",
        "path_matcher.go",
        "search_related_work.go",
        "search_service.go",
        "search_service_streaming.go",
        "search_service_sync.go",
        "vcs_proto.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/searchrpc",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//pkg/classifier",
        "//proto/session/v1:sessionv1_go",
        "//server/adapters",
        "//session/claudehistory",
        "//session/git/backend",
        "//session/gitprovider",
        "//session/instance",
        "//session/search",
        "//session/vc",
        "//telemetry",
        "@com_connectrpc_connect//:connect",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_protobuf//types/known/timestamppb",
        "@org_golang_x_sync//singleflight",
    ],
)

alias(
    name = "go_default_library",
    actual = ":searchrpc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "searchrpc_test",
    srcs = [
        "history_service_test.go",
        "local_file_service_test.go",
        "path_matcher_test.go",
        "search_pagination_test.go",
        "search_related_work_test.go",
        "search_service_limits_test.go",
        "search_service_refs_test.go",
        "search_service_streaming_test.go",
        "search_service_test.go",
        "searchrpc_golden_test.go",
        "vcs_proto_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":searchrpc"],
    deps = [
        "//log",
        "//pkg/classifier",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/services/internal/svctest",
        "//session/claudehistory",
        "//session/git",
        "//session/git/backend",
        "//session/instance",
        "//session/search",
        "//session/vc",
        "//testutil/gitfake",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_sys//unix",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
