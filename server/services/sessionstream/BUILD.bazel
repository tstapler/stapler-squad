load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "sessionstream",
    srcs = [
        "detection.go",
        "diff.go",
        "event_converter.go",
        "external_websocket.go",
        "handler.go",
        "session_streamer.go",
        "stream_terminal.go",
        "terminal_service.go",
        "watch.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/sessionstream",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/adapters",
        "//server/events",
        "//server/notifications",
        "//server/services/access",
        "//server/services/federation",
        "//server/services/fsops",
        "//server/services/internal/streammetrics",
        "//session",
        "//session/detection",
        "//session/domain",
        "//session/external",
        "//session/git",
        "//session/instance",
        "//session/markerstore",
        "//session/sshremote",
        "//session/tmux",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":sessionstream",
    visibility = ["//visibility:public"],
)

go_test(
    name = "sessionstream_test",
    srcs = [
        "context_lines_test.go",
        "deploy_id_test.go",
        "event_converter_test.go",
        "stream_terminal_test.go",
        "terminal_service_test.go",
        "testmain_test.go",
    ],
    embed = [":sessionstream"],
    deps = [
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/internal/svctest",
        "//session/domain",
        "//session/instance",
        "//session/sendkeysguard",
        "//session/sshremote",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
