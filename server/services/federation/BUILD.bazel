load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "federation",
    srcs = [
        "deep_link_resolver.go",
        "federated_watch_aggregator.go",
        "session_federation.go",
        "session_federation_dial.go",
        "session_federation_terminal.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/federation",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//session/deeplink",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/hostclaim",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":federation",
    visibility = ["//visibility:public"],
)

go_test(
    name = "federation_test",
    srcs = [
        "deep_link_resolver_test.go",
        "export_test.go",
        "federated_watch_aggregator_test.go",
        "session_federation_dial_test.go",
        "session_federation_filter_test.go",
        "session_federation_terminal_test.go",
        "session_federation_test.go",
        "session_service_federation_test.go",
    ],
    embed = [":federation"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services",
        "//server/services/internal/svctest",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/hostclaim",
        "//session/instance",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
