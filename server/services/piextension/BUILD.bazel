load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "piextension",
    srcs = [
        "pi_extension_health.go",
        "pi_extension_status_handler.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/piextension",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "@com_github_puzpuzpuz_xsync_v4//:xsync",
    ],
)

alias(
    name = "go_default_library",
    actual = ":piextension",
    visibility = ["//visibility:public"],
)

go_test(
    name = "piextension_test",
    srcs = [
        "pi_extension_golden_test.go",
        "pi_extension_health_test.go",
        "pi_extension_status_handler_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":piextension"],
    deps = [
        "//server/services/internal/svctest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
