load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "debugseed",
    srcs = ["backlog_debug_seed_handler.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/debugseed",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//server/services",
        "//session",
        "//session/backlog/pipeline",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "@com_github_google_uuid//:uuid",
    ],
)

alias(
    name = "go_default_library",
    actual = ":debugseed",
    visibility = ["//visibility:public"],
)

# Read by session and server/services tests that scan handler sources for path-keyed guards.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
