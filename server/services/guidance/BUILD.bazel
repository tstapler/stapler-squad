load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "guidance",
    srcs = [
        "guidance_ack_detector.go",
        "guidance_answerer.go",
        "guidance_debug_seed_handler.go",
        "guidance_peer_help.go",
        "guidance_request_service.go",
        "guidance_session_reaper.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/guidance",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/services/questionkit",
        "//server/wakes",
        "//session",
        "//session/dialogpresence",
        "//session/domain",
        "//session/itemlink",
        "//session/panereply",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":guidance",
    visibility = ["//visibility:public"],
)

go_test(
    name = "guidance_test",
    srcs = [
        "guidance_ack_detector_test.go",
        "guidance_answerer_test.go",
        "guidance_request_mirror_proto_test.go",
        "guidance_request_service_test.go",
        "guidance_session_reaper_test.go",
        "helpers_test.go",
        "testmain_test.go",
    ],
    data = ["//session/testdata:all"],
    embed = [":guidance"],
    deps = [
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/internal/svctest",
        "//server/services/questionkit",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/panereply",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//proto",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
