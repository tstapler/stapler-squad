load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "updatecheck",
    srcs = ["update_check_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/updatecheck",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//pkg/changelog",
        "//server/services/featureflags",
        "//server/services/flagsvc",
    ],
)

alias(
    name = "go_default_library",
    actual = ":updatecheck",
    visibility = ["//visibility:public"],
)

go_test(
    name = "updatecheck_test",
    srcs = [
        "testmain_test.go",
        "update_check_golden_test.go",
        "update_check_service_test.go",
    ],
    embed = [":updatecheck"],
    deps = [
        "//server/services/internal/svctest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
