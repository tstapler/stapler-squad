load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "autonomysvc",
    srcs = [
        "autonomous_orchestration_service.go",
        "autonomous_stale_work.go",
        "autonomous_stall_recovery.go",
        "autonomous_stop_detail.go",
        "lease_wedge.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/autonomysvc",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//pkg/events",
        "//proto/session/v1:sessionv1_go",
        "//server/deliverygate",
        "//server/events",
        "//server/services/notify",
        "//server/services/secretscan",
        "//session",
        "//session/autonomous",
        "//session/backlog/pipeline",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/headless",
        "//session/instance",
        "//session/nudgeoutcomes",
    ],
)

alias(
    name = "go_default_library",
    actual = ":autonomysvc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "autonomysvc_test",
    srcs = [
        "autonomous_apply_stop_test.go",
        "autonomous_integration_test.go",
        "autonomous_orchestration_service_characterization_test.go",
        "autonomous_orchestration_service_class_test.go",
        "autonomous_orchestration_service_stop_test.go",
        "autonomous_orchestration_service_test.go",
        "autonomous_stale_work_test.go",
        "autonomous_stall_recovery_nudge_test.go",
        "autonomous_stop_detail_test.go",
        "autonomy_golden_test.go",
        "can_restart_test.go",
        "helpers_test.go",
        "lease_wedge_test.go",
        "nudge_outcomes_stall_test.go",
        "testmain_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":autonomysvc"],
    deps = [
        "//config",
        "//server/deliverygate",
        "//server/events",
        "//server/notifications",
        "//server/services/internal/svctest",
        "//session",
        "//session/autonomous",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/headless",
        "//session/instance",
        "//session/nudgeoutcomes",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
