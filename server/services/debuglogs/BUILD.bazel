load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "debuglogs",
    srcs = [
        "debug_snapshot.go",
        "log_header_scan.go",
        "log_service.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/debuglogs",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//executor/safeexec",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/services/approvalkit",
        "//session",
        "//session/domain",
        "//session/instance",
        "//session/tmux",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":debuglogs",
    visibility = ["//visibility:public"],
)

go_test(
    name = "debuglogs_test",
    srcs = [
        "debug_snapshot_pr_test.go",
        "debug_snapshot_rpc_test.go",
        "fixtures_test.go",
        "log_service_test.go",
        "parselogs_bench_test.go",
        "parselogs_odd_test.go",
        "testmain_test.go",
    ],
    embed = [":debuglogs"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/approvalkit",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/instance",
        "//session/queue",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
