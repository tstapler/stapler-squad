load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "unfinishedwork",
    srcs = ["unfinished_work_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/unfinishedwork",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "//server/events",
        "//server/services/internal/streammetrics",
        "//session",
        "//session/git",
        "//session/git/backend",
        "//session/gitprovider",
        "//session/headless",
        "//session/unfinished",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":unfinishedwork",
    visibility = ["//visibility:public"],
)

go_test(
    name = "unfinishedwork_test",
    srcs = [
        "unfinished_work_misc_test.go",
        "unfinished_work_service_watchdir_test.go",
        "unfinished_work_test.go",
    ],
    embed = [":unfinishedwork"],
    deps = [
        "//executor/safeexec",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/internal/svctest",
        "//session/git",
        "//session/git/backend",
        "//session/instance",
        "//session/unfinished",
        "//testutil/gitfake",
        "@com_connectrpc_connect//:connect",
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//plumbing",
        "@com_github_go_git_go_git_v5//plumbing/object",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
