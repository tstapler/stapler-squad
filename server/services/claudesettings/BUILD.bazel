load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "claudesettings",
    srcs = [
        "claude_settings_parser.go",
        "claude_settings_watcher.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/claudesettings",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//pkg/classifier",
        "@com_github_fsnotify_fsnotify//:fsnotify",
    ],
)

alias(
    name = "go_default_library",
    actual = ":claudesettings",
    visibility = ["//visibility:public"],
)

go_test(
    name = "claudesettings_test",
    srcs = [
        "claude_settings_golden_test.go",
        "claude_settings_parser_test.go",
        "claude_settings_pending_test.go",
        "claude_settings_watcher_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":claudesettings"],
    deps = [
        "//pkg/classifier",
        "//server/services/internal/svctest",
        "@com_github_fsnotify_fsnotify//:fsnotify",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
