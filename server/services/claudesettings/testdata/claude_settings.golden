== ParseClaudeSettings
body[0]=""
  err=settings file not found notfound=true
  perms=<nil>
body[1]="{}"
  err=<nil> notfound=false
  perms=<nil>
body[2]="{\"permissions\":null}"
  err=<nil> notfound=false
  perms=<nil>
body[3]="{\"permissions\":{}}"
  err=<nil> notfound=false
  allow=[] deny=[] allownil=true denynil=true
body[4]="{\"permissions\":{\"allow\":[]}}"
  err=<nil> notfound=false
  allow=[] deny=[] allownil=false denynil=true
body[5]="{\"permissions\":{\"allow\":[\"Bash(git *)\",\"Read\"]}}"
  err=<nil> notfound=false
  allow=["Bash(git *)" "Read"] deny=[] allownil=false denynil=true
body[6]="{\"permissions\":{\"allow\":[\"Bash(git status)\"]}}"
  err=<nil> notfound=false
  allow=["Bash(git status)"] deny=[] allownil=false denynil=true
body[7]="{\"permissions\":{\"deny\":[\"Bash(rm -rf *)\",\"Write\"]}}"
  err=<nil> notfound=false
  allow=[] deny=["Bash(rm -rf *)" "Write"] allownil=true denynil=false
body[8]="{\"permissions\":{\"allow\":[\"Bash(git push*)\"],\"deny\":[\"Bash(git push --force*)\"]}}"
  err=<nil> notfound=false
  allow=["Bash(git push*)"] deny=["Bash(git push --force*)"] allownil=false denynil=false
body[9]="{\"permissions\":{\"allow\":[\"Bash(npm test\"]}}"
  err=<nil> notfound=false
  allow=["Bash(npm test"] deny=[] allownil=false denynil=true
body[10]="{\"permissions\":{\"allow\":[\"Bash(a[b)\"]}}"
  err=<nil> notfound=false
  allow=["Bash(a[b)"] deny=[] allownil=false denynil=true
body[11]="{\"permissions\":{\"allow\":[1,2]}}"
  err=parse <DIR>/settings.json: json: cannot unmarshal number into Go struct field ClaudePermissions.permissions.allow of type string notfound=false
  perms=<nil>
body[12]="{\"permissions\":{\"allow\":\"Bash\"}}"
  err=parse <DIR>/settings.json: json: cannot unmarshal string into Go struct field ClaudePermissions.permissions.allow of type []string notfound=false
  perms=<nil>
body[13]="{\"permissions\": {\"allow\": ["
  err=parse <DIR>/settings.json: unexpected end of JSON input notfound=false
  perms=<nil>
body[14]="not json"
  err=parse <DIR>/settings.json: invalid character 'o' in literal null (expecting 'u') notfound=false
  perms=<nil>
body[15]="[]"
  err=parse <DIR>/settings.json: json: cannot unmarshal array into Go value of type services.claudeSettingsFile notfound=false
  perms=<nil>
body[16]="{\"permissions\":{\"allow\":[\"Bash(ls)\",\"Bash(ls)\",\"Bash(ls *)\"],\"deny\":[\"Edit\"]},\"other\":{\"x\":1}}"
  err=<nil> notfound=false
  allow=["Bash(ls)" "Bash(ls)" "Bash(ls *)"] deny=["Edit"] allownil=false denynil=false
dir-as-file err=read <DIR>: read <DIR>: is a directory notfound=false
