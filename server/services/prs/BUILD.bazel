load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "prs",
    srcs = [
        "pr_creation_service.go",
        "pr_holds_shared.go",
        "pr_nudge_prompt.go",
        "prwatch_signature.go",
        "reasons.go",
        "session_pr_holds.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/prs",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//github",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/access",
        "//session",
        "//session/backlog",
        "//session/domain",
        "//session/git",
        "//session/headless",
        "//session/instance",
        "//session/steertext",
        "//session/unfinished",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":prs",
    visibility = ["//visibility:public"],
)

go_test(
    name = "prs_test",
    srcs = [
        "create_pull_request_test.go",
        "pr_creation_service_test.go",
        "pr_nudge_prompt_test.go",
        "prwatch_signature_test.go",
        "session_pr_holds_test.go",
        "testmain_test.go",
    ],
    embed = [":prs"],
    deps = [
        "//github",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/access",
        "//server/services/internal/svctest",
        "//session",
        "//session/backlog",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//session/headless",
        "//session/instance",
        "//session/tmux",
        "@com_connectrpc_connect//:connect",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
