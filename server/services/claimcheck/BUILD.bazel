load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "claimcheck",
    srcs = [
        "claim_checker.go",
        "foreign_claim_gate.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/claimcheck",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//server/services/featureflags",
        "//server/services/federation",
        "//session",
        "//session/hostclaim",
    ],
)

alias(
    name = "go_default_library",
    actual = ":claimcheck",
    visibility = ["//visibility:public"],
)

go_test(
    name = "claimcheck_test",
    srcs = [
        "claim_checker_test.go",
        "testmain_test.go",
    ],
    embed = [":claimcheck"],
    deps = [
        "//server/services/internal/svctest",
        "//session/hostclaim",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
