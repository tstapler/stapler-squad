load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "vcsstatus",
    srcs = [
        "testing.go",
        "vcs_range_cache.go",
        "vcs_status_cache.go",
        "vcs_status_flight.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/vcsstatus",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/services/searchrpc",
        "//session/git",
        "//session/vc",
        "//telemetry",
        "@com_connectrpc_connect//:connect",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":vcsstatus",
    visibility = ["//visibility:public"],
)

go_test(
    name = "vcsstatus_test",
    srcs = [
        "testmain_test.go",
        "vcs_cache_coalesce_test.go",
        "vcs_range_cache_test.go",
    ],
    embed = [":vcsstatus"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "//session/git",
        "//session/vc",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
