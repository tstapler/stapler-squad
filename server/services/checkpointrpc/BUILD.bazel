load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "checkpointrpc",
    srcs = ["checkpoint_service.go"],
    importpath = "github.com/tstapler/stapler-squad/server/services/checkpointrpc",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//session",
        "//session/domain",
        "//session/external",
        "//session/instance",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":checkpointrpc",
    visibility = ["//visibility:public"],
)

go_test(
    name = "checkpointrpc_test",
    srcs = [
        "checkpoint_golden_test.go",
        "testmain_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":checkpointrpc"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/events",
        "//server/services/internal/svctest",
        "//session",
        "//session/domain",
        "//session/instance",
        "//session/queue",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
