    readstate cfg={"host":"github.com","owner":"acme","repo":"widget"} ext="42"
    close cfg={"host":"github.com","owner":"acme","repo":"widget"} ext="42" labels=[] closeLabel=""
    comment cfg={"host":"github.com","owner":"acme","repo":"widget"} ext="42" body="Closed automatically — the linked backlog item was marked done in stapler-squad."
