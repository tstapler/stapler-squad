load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "windowfocus",
    srcs = [
        "service.go",
        "window_activator.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/services/windowfocus",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//server/services/notify",
        "@com_connectrpc_connect//:connect",
    ],
)

alias(
    name = "go_default_library",
    actual = ":windowfocus",
    visibility = ["//visibility:public"],
)

go_test(
    name = "windowfocus_test",
    srcs = [
        "service_test.go",
        "testmain_test.go",
        "window_activator_test.go",
    ],
    embed = [":windowfocus"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/services/internal/svctest",
        "@com_connectrpc_connect//:connect",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
