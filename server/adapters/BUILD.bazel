load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "adapters",
    srcs = [
        "instance_adapter.go",
        "review_queue_adapter.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/server/adapters",
    visibility = ["//visibility:public"],
    deps = [
        "//github",
        "//log",
        "//proto/session/v1:sessionv1_go",
        "//session",
        "//session/cdp",
        "//session/detection",
        "//session/detection/ratelimit",
        "//session/tokens",
        "//session/vnc",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

alias(
    name = "go_default_library",
    actual = ":adapters",
    visibility = ["//visibility:public"],
)

go_test(
    name = "adapters_test",
    srcs = [
        "instance_adapter_test.go",
        "review_queue_adapter_test.go",
    ],
    embed = [":adapters"],
    deps = [
        "//github",
        "//proto/session/v1:sessionv1_go",
        "//session",
        "//session/detection",
        "//session/detection/ratelimit",
        "//session/git",
        "//session/tmux",
        "//session/tokens",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_crypto//ssh",
    ],
)
