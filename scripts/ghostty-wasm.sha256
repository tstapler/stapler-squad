# Recorded sha256 of web-app/build/ghostty-own/ghostty-vt.wasm, one line per
# "<rev12>-zig<version> <sha256>". scripts/build-ghostty-wasm.sh prints the
# exact line to add for a new pin; `--verify` (CI) fails on a mismatch.
