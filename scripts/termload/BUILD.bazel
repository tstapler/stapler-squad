load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "termload_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/scripts/termload",
    visibility = ["//visibility:private"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//server/protocol",
        "@com_github_gorilla_websocket//:websocket",
        "@org_golang_google_protobuf//proto",
    ],
)

go_binary(
    name = "termload",
    embed = [":termload_lib"],
    visibility = ["//visibility:public"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
