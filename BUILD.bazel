# Keep Gazelle out of the generated ent tree (present after `make sync`) but inside the hand-kept
# session/ent/schema: these seven globs exclude every name under session/ent except exactly "schema"
# (a prefix-by-prefix negation, because the doublestar matcher has no whole-word negation). S11 found
# the earlier two-line form leaked a BUILD file into any new entity whose name starts with "sc".
# gazelle:exclude session/ent/[!s]*
# gazelle:exclude session/ent/s[!c]*
# gazelle:exclude session/ent/sc[!h]*
# gazelle:exclude session/ent/sch[!e]*
# gazelle:exclude session/ent/sche[!m]*
# gazelle:exclude session/ent/schem[!a]*
# gazelle:exclude session/ent/schema?*
# Generated ent packages live in //tools/bzl/ent (2 lines cover all 52; the schema alias is there too).
# gazelle:resolve go github.com/tstapler/stapler-squad/session/ent //tools/bzl/ent:ent
# gazelle:resolve_regexp go ^github.com/tstapler/stapler-squad/session/ent/(.+)$ //tools/bzl/ent:$1

# Generated protos live in //proto/session/v1 (genrule from buf); the hand-written S1 go_proto_library
# attempts there claim the same importpaths, so Gazelle needs these to disambiguate.
# gazelle:resolve go github.com/tstapler/stapler-squad/gen/proto/go/session/v1 //proto/session/v1:sessionv1_go
# gazelle:resolve go github.com/tstapler/stapler-squad/gen/proto/go/session/v1/sessionv1connect //proto/session/v1:sessionv1connect_go
# The S12 nogo twin library (tools/bzl/spike-nogo:norawgitcli_rootdeps) reuses norawgitcli's importpath.
# gazelle:resolve go github.com/tstapler/stapler-squad/tools/lint/norawgitcli //tools/lint/norawgitcli:norawgitcli
# server/web/fixture (S3 spike) reuses server/web's importpath.
# gazelle:resolve go github.com/tstapler/stapler-squad/server/web //server/web:web

gazelle(name = "gazelle")

# `make sync` (BUILD_SYSTEM=bazel) runs this: copies proto Go/connect and ent outputs into the tree.
sh_binary(
    name = "sync-gen",
    srcs = ["//tools/bzl:sync_gen.sh"],
    args = [
        "$(rootpaths //proto/session/v1:gen_go)",
        "$(rootpaths //tools/bzl/ent:ent_gen)",
    ],
    data = [
        "//proto/session/v1:gen_go",
        "//tools/bzl/ent:ent_gen",
    ],
)

exports_files([
    "buf.yaml",
    "buf.gen.bazel.yaml",
    "buf.gen.bazel-ts.yaml",
])

