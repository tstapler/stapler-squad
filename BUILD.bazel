config_setting(
    name = "stamped",
    values = {"stamp": "1"},
)

# Uninstrumented go_binary: kept only for the P5 parity harness. It is not shipped. The
# shipped binary is //:stapler-squad below. main.version and the buildinfo fields mirror Makefile's LDFLAGS. Only set when stamping (the
# {KEY} placeholders are workspace-status values); unstamped builds keep the "dev" defaults.
# runtime.godebugDefault carries go.mod's `godebug netdns=go`, which rules_go does not read (Task 3.4d).
go_binary(
    name = "stapler-squad_plain",
    embed = [":stapler-squad_lib"],
    visibility = ["//visibility:public"],
    x_defs = select({
        ":stamped": {
            "runtime.godebugDefault": "netdns=go",
            "main.version": "{STABLE_GIT_VERSION}",
            "github.com/tstapler/stapler-squad/pkg/buildinfo.Version": "{STABLE_GIT_VERSION}",
            "github.com/tstapler/stapler-squad/pkg/buildinfo.Branch": "{STABLE_GIT_BRANCH}",
            "github.com/tstapler/stapler-squad/pkg/buildinfo.Commit": "{STABLE_GIT_COMMIT}",
            "github.com/tstapler/stapler-squad/pkg/buildinfo.Worktree": "{STABLE_GIT_WORKTREE}",
        },
        "//conditions:default": {"runtime.godebugDefault": "netdns=go"},
    }),
)

config_setting(
    name = "embed_tmux_and_tymux",
    flag_values = {
        "//tools/bzl/flags:embed_tmux": "true",
        "//tools/bzl/flags:embed_tymux": "true",
    },
)

# The one stapler-squad binary: always the otelc-woven build (owner decision, ADR-005 amendment, spike S15b).
# Sandboxed and remote-cacheable (tools/bzl/otel_weave_hermetic.bzl): declared inputs only, the committed otelc
# overlay in tools/bzl/otel_overlay, and a go.sum-verified module cache. Stamping comes from --stamp.
otel_weave_hermetic(
    name = "otel_modcache",
    mode = "modcache",
)

otel_weave_hermetic(
    name = "otelc_bin",
    modcache = ":otel_modcache",
    mode = "otelc",
)

otel_weave_hermetic(
    name = "stapler-squad",
    ent = ["//tools/bzl/ent:ent_gen"],
    gen = ["//proto/session/v1:gen_go"],
    go_tags = select({
        ":embed_tmux_and_tymux": [
            "embed_tmux",
            "embed_tymux",
        ],
        "//tools/bzl/flags:embed_tmux_on": ["embed_tmux"],
        "//conditions:default": [],
    }),
    libs = [
        ":stapler-squad_lib",
        "//instrumentation/otelc/safeexec",
    ],
    modcache = ":otel_modcache",
    otelc = ":otelc_bin",
    # On a macOS target the weave also stages macos/Info.plist and links it with -sectcreate (Task 5.1b).
    stage = select({
        ":embed_tmux_and_tymux": [
            "//session/tmux/embed:tmux_staged",
            "//session/tymux/embed:tymuxd_staged",
        ],
        "//tools/bzl/flags:embed_tmux_on": ["//session/tmux/embed:tmux_staged"],
        "//conditions:default": [],
    }) + select({
        "@platforms//os:macos": ["//macos:Info.plist"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    web = "//server/web:dist_staged",
)

