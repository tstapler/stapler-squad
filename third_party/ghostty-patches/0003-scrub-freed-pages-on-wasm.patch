     const page_alloc = self.pool.pages.arena.child_allocator;
     var it = self.pages.first;
     while (it) |node| : (it = node.next) {
+        // ssq: the wasm allocator recycles freed memory without zeroing it,
+        // but pages assume zeroed backing memory (mmap semantics), so a
