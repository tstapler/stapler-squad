load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "linear",
    srcs = ["keychain.go"],
    importpath = "github.com/tstapler/stapler-squad/linear",
    visibility = ["//visibility:public"],
    deps = ["@com_github_zalando_go_keyring//:go-keyring"],
)

alias(
    name = "go_default_library",
    actual = ":linear",
    visibility = ["//visibility:public"],
)

go_test(
    name = "linear_test",
    srcs = [
        "keychain_test.go",
        "main_test.go",
    ],
    embed = [":linear"],
    deps = ["@com_github_zalando_go_keyring//:go-keyring"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
