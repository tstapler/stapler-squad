load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "changelog",
    srcs = [
        "embedded.go",
        "parser.go",
        "version.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/pkg/changelog",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":changelog",
    visibility = ["//visibility:public"],
)

go_test(
    name = "changelog_test",
    srcs = ["parser_test.go"],
    data = ["//:CHANGELOG.md"],
    embed = [":changelog"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
