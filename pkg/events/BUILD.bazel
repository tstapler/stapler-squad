load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "events",
    srcs = [
        "bus.go",
        "heartbeat.go",
        "notification_metadata.go",
        "subscriber.go",
        "types.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/pkg/events",
    visibility = ["//visibility:public"],
    deps = [
        "//session",
        "//session/detection",
        "//session/sshremote",
        "//tools/bzl/ent",
    ],
)

alias(
    name = "go_default_library",
    actual = ":events",
    visibility = ["//visibility:public"],
)

go_test(
    name = "events_test",
    srcs = [
        "bus_bench_test.go",
        "bus_test.go",
        "types_test.go",
    ],
    embed = [":events"],
    deps = [
        "//session",
        "//testutil",
    ],
)

exports_files(
    ["types.go"],
    visibility = ["//server/wakes:__pkg__"],
)
