{
  "name": "web-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "@ast-grep/cli"
  ],
  "overrides": {
    "eval": "0.1.8"
  },
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('bun/')){console.error('Use bun install (bun@1.4.3); npm, yarn and pnpm are not supported in web-app/. See docs/how-to/use-bun-in-web-app.md');process.exit(1)}\"",
    "dev": "if [ \"$WEB_BUILD\" = bun ]; then bun run dev:bun; else bun run dev:next; fi",
    "dev:next": "next dev --port ${PORT:-3001} --hostname localhost",
    "dev:bun": "bun build/dev.ts",
    "build": "if [ \"$WEB_BUILD\" = bun ]; then bun run build:bun; else bun run build:next; fi",
    "build:next": "next build",
    "build:bun": "bun build/build.ts",
    "start": "if [ \"$WEB_BUILD\" = bun ]; then bun run start:bun; else bun run start:next; fi",
    "start:next": "next start --port ${PORT:-3001}",
    "start:bun": "echo 'The Bun build is static output served by the Go binary: make web-build WEB_BUILD=bun, then ./stapler-squad.' >&2; exit 1",
    "lint": "bun run lint:eslint && bun run lint:css && bun run lint:css-vars",
    "lint:eslint": "eslint .",
    "lint:affected": "bash scripts/lint-affected.sh",
    "lint:css": "stylelint 'src/**/*.css' --allow-empty-input",
    "lint:css-vars": "node scripts/check-css-vars.mjs",
    "test": "jest",
    "test:build": "jest --selectProjects build --no-coverage",
    "oracle:ve": "bun build/oracle/ve-oracle.ts",
    "verify:eval-patch": "bun scripts/verify-eval-patch.mjs",
    "check:dependency-screen": "node scripts/check-dependency-screen.mjs",
    "test:codemods": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:watch": "jest --watch",
    "test:affected": "jest --changedSince=${BASE:-origin/main}",
    "test:e2e": "playwright test",
    "test:e2e:dev-mode": "playwright test --config=tests/e2e/playwright.dev-mode.config.ts",
    "test:stress": "playwright test tests/e2e/terminal-stress",
    "test:stress:headed": "playwright test tests/e2e/terminal-stress --headed",
    "test:stress:debug": "playwright test tests/e2e/terminal-stress --debug",
    "test:report": "playwright show-report",
    "size-limit": "size-limit",
    "test:benchmark": "playwright test tests/e2e/benchmarks/",
    "test:benchmark:throughput": "playwright test tests/e2e/benchmarks/terminal-throughput.spec.ts",
    "test:benchmark:latency": "playwright test tests/e2e/benchmarks/rpc-latency.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-contrast": "npx --yes tsx scripts/check-theme-contrast.ts",
    "lint:duplicates": "jscpd src",
    "report:component-usage": "node scripts/component-usage-report.mjs --md",
    "audit:css-tokens": "ts-node scripts/audit-css-tokens.ts",
    "validate-catalog": "ts-node --project tsconfig.node.json src/lib/features/validate.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-zone": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-document-load": "0.67.0",
    "@opentelemetry/instrumentation-fetch": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@radix-ui/react-accordion": "^1.2.17",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-virtual": "^3.13.25",
    "@vanilla-extract/recipes": "^0.5.7",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "codemirror": "^6.0.2",
    "cronstrue": "^3.24.0",
    "dompurify": "^3.4.3",
    "fuse.js": "^7.3.0",
    "ghostty-web": "0.4.0",
    "it-ws": "^6.1.5",
    "lucide-react": "^1.14.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router": "7.18.4",
    "react-virtuoso": "^4.18.7",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@babel/core": "^7",
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@chromatic-com/storybook": "^3.2.7",
    "@playwright/test": "^1.57.0",
    "@size-limit/file": "^11.0.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-themes": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-webpack5": "^8.6.18",
    "@swc/core": "^1.15.33",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "1.3.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/integration": "8.0.11",
    "@vanilla-extract/next-plugin": "^2.5.1",
    "axe-core": "4.10.3",
    "babel-loader": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-analytics": "file:./eslint-plugin-analytics",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-rpc-lifecycle": "file:./eslint-plugin-rpc-lifecycle",
    "fast-check": "^4.10.2",
    "glob": "^13.0.6",
    "globals": "14.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jscpd": "^4.0.9",
    "monaco-editor": "^0.55.1",
    "size-limit": "^11.0.0",
    "storybook": "^8.6.18",
    "stylelint": "^17.6.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.1"
  },
  "patchedDependencies": {
    "eval@0.1.8": "patches/eval@0.1.8.patch"
  }
}
