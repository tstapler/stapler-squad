{
  "id": "gboard-enter-wrapped-in-composition",
  "source": "synthetic",
  "keyboard": "gboard",
  "notes": "Enter arrives as insertLineBreak while a composition is live, then compositionend echoes the text; exactly one CR and no re-send. Source: https://lists.w3.org/Archives/Public/public-editing-tf/2017Jun/0007.html",
  "events": [
    {
      "kind": "compositionstart",
      "t": 10
    },
    {
      "kind": "compositionupdate",
      "data": "l",
      "t": 20
    },
    {
      "kind": "beforeinput",
      "inputType": "insertCompositionText",
      "data": "l",
      "value": "l",
      "selStart": 1,
      "selEnd": 1,
      "t": 30
    },
    {
      "kind": "input",
      "value": "l",
      "selStart": 1,
      "selEnd": 1,
      "t": 40
    },
    {
      "kind": "compositionupdate",
      "data": "ls",
      "t": 50
    },
    {
      "kind": "beforeinput",
      "inputType": "insertCompositionText",
      "data": "ls",
      "value": "ls",
      "selStart": 2,
      "selEnd": 2,
      "t": 60
    },
    {
      "kind": "input",
      "value": "ls",
      "selStart": 2,
      "selEnd": 2,
      "t": 70
    },
    {
      "kind": "beforeinput",
      "inputType": "insertLineBreak",
      "data": null,
      "value": "ls",
      "selStart": 2,
      "selEnd": 2,
      "t": 80
    },
    {
      "kind": "compositionend",
      "data": "ls",
      "t": 90
    },
    {
      "kind": "input",
      "value": "​",
      "selStart": 1,
      "selEnd": 1,
      "t": 100
    }
  ],
  "expectedBytes": "ls\r",
  "finalText": "ls\r"
}
