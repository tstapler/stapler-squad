{
  "id": "gboard-swipe-word",
  "source": "synthetic",
  "keyboard": "gboard",
  "notes": "Swipe typing delivers the whole word in one composition update, then a trailing space is committed. Source: https://lists.w3.org/Archives/Public/public-editing-tf/2017Jun/0007.html",
  "events": [
    {
      "kind": "compositionstart",
      "t": 10
    },
    {
      "kind": "compositionupdate",
      "data": "hello",
      "t": 20
    },
    {
      "kind": "beforeinput",
      "inputType": "insertCompositionText",
      "data": "hello",
      "value": "hello",
      "selStart": 5,
      "selEnd": 5,
      "t": 30
    },
    {
      "kind": "input",
      "value": "hello",
      "selStart": 5,
      "selEnd": 5,
      "t": 40
    },
    {
      "kind": "compositionend",
      "data": "hello",
      "t": 50
    },
    {
      "kind": "input",
      "value": "​",
      "selStart": 1,
      "selEnd": 1,
      "t": 60
    },
    {
      "kind": "keydown",
      "key": "Unidentified",
      "keyCode": 229,
      "isComposing": false,
      "t": 70
    },
    {
      "kind": "beforeinput",
      "inputType": "insertText",
      "data": " ",
      "value": " ",
      "selStart": 1,
      "selEnd": 1,
      "t": 80
    },
    {
      "kind": "input",
      "value": " ",
      "selStart": 1,
      "selEnd": 1,
      "t": 90
    }
  ],
  "expectedBytes": "hello ",
  "finalText": "hello "
}
