{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "incremental": false
  },
  "include": [
    "build/**/*.ts",
    "build/**/*.tsx",
    "scripts/verify-eval-patch.mjs",
