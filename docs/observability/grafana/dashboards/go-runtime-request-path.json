            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, rpc_method)(rate(db_queries_per_request_bucket[5m]))))",
          "legendFormat": "{{rpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HTTP p50 vs unary RPC handler p50",
      "description": "The gap is time outside the handler: middleware, header read, response write, connection queueing. HTTP has no route label and includes long-lived streams, so compare medians; unary RPCs exclude Watch*/Stream* methods. Buckets run to 120s, so a stall past 10s no longer clamps to exactly 10s.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le)(rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "http p50 (accept to response)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le)(rate(rpc_server_duration_milliseconds_bucket{rpc_method!~\"Watch.*|Stream.*\"}[5m]))) / 1000",
          "legendFormat": "unary rpc p50 (handler + interceptors)",
          "refId": "B"
        }
      ]
    },
