        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "topk(8, sum by (rpc_method)(rpc_server_inflight))",
          "legendFormat": "{{rpc_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "DB statements per request (p95)",
      "description": "N+1 detector: a handler above ~30 statements per call is a batching candidate. Also on the RPC span as db.queries.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
