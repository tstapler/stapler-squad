{
  "title": "stapler-squad: GetVCSStatus stages",
  "description": "Per-stage cost of GetVCSStatus (git_status, shipped_commits, diff_stat) and the SHA-range cache that fronts the last two. Metric definitions: server/services/vcs_status_flight.go, server/services/vcs_range_cache.go.",
  "uid": "ssq-vcs-status-stages",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "stapler-squad",
    "vcs"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Slow VCS spans in Tempo (Explore)",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "/explore?schemaVersion=1&orgId=1&panes={%22a%22%3A{%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22datasource%22%3A{%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22}%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22{%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20name%20%3D~%20%5C%22vcs.status.%28compute%7Cshipped_commits%7Cdiff_stat%7Cgit_status%29%5C%22%20%26%26%20duration%20%3E%205s%20}%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20}%5D%2C%22range%22%3A{%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}}",
      "tooltip": "Open Grafana Explore on Tempo for vcs.status spans over 5s in this dashboard's time range"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "stage",
        "label": "Stage",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": "git_status,shipped_commits,diff_stat",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "GetVCSStatus stages",
      "id": 100,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Stage p95 (git_status / shipped_commits / diff_stat)",
      "type": "timeseries",
      "description": "Wall time of each stage inside one shared GetVCSStatus computation. shipped_commits and diff_stat are budgeted (10s each); a flat line at the budget means the stage is being cut off, not finishing. Open slow traces via the dashboard link.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vcs_status_stage_duration_milliseconds_bucket{stage=~\"$stage\"}[$__rate_interval])) by (le, stage))",
          "legendFormat": "p95 {{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Stage p50",
      "type": "timeseries",
      "description": "Typical stage cost; compare with p95 to separate a slow repo from host contention.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vcs_status_stage_duration_milliseconds_bucket{stage=~\"$stage\"}[$__rate_interval])) by (le, stage))",
          "legendFormat": "p50 {{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Range cache hit ratio by stage",
      "type": "timeseries",
      "description": "Share of shipped_commits / diff_stat lookups served from the (workdir, base SHA, head SHA) cache. Low ratio with a moving HEAD is expected; low ratio with a stable HEAD means the cache is being bypassed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(vcs_status_range_cache_total{result=\"hit\"}[$__rate_interval])) by (stage) / sum(rate(vcs_status_range_cache_total[$__rate_interval])) by (stage)",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Range cache lookups by result",
      "type": "timeseries",
      "description": "hit, miss, and negative_hit (stage exceeded its budget recently and is not retried for 1 minute).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(vcs_status_range_cache_total[$__rate_interval])) by (stage, result)",
          "legendFormat": "{{stage}} {{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Stage budget overruns and errors",
      "type": "timeseries",
      "description": "Stage executions that ended budget_exceeded or error, per second.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(vcs_status_stage_duration_milliseconds_count{result=~\"budget_exceeded|error\"}[$__rate_interval])) by (stage, result)",
          "legendFormat": "{{stage}} {{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Whole computation p95 and queue wait p95",
      "type": "timeseries",
      "description": "vcs.status.compute.duration and vcs.status.queue_wait.duration for context (queue wait is time spent waiting for one of 4 computation slots).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vcs_status_compute_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "compute p95",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vcs_status_queue_wait_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "queue wait p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    }
  ]
}
