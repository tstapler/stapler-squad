{
  "title": "stapler-squad: tymux backend",
  "description": "tymux vs tmux backend: operation latency (RED), attach stream health (reconnects, gaps, heartbeat age), backend mix, and tymuxd supervision.",
  "uid": "ssq-tymux-backend",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "green",
        "name": "Deploys",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "deploy",
            "stapler-squad"
          ],
          "type": "tags"
        },
        "type": "tags"
      }
    ]
  },
  "links": [{"title": "Traces in Tempo (Explore)", "type": "link", "icon": "external link", "targetBlank": true, "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20%28name%20%3D~%20%5C%22session.backend.%2A%5C%22%20%7C%7C%20name%20%3D~%20%5C%22tymux.v1.%2A%5C%22%29%20%26%26%20name%20%21%3D%20%5C%22tymux.v1.TymuxService%2FAttach%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "tooltip": "Open Grafana Explore on Tempo with this dashboard's time range"}],
  "panels": [
    {
      "type": "row",
      "title": "Operation latency (RED: Duration, Rate)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100
    },
    {
      "id": 1,
      "title": "Operation latency p50 by backend + operation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": { "links": [{"title": "Backend lifecycle spans for this backend in Tempo (Explore)", "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.backend%20%3D%20%5C%22${__field.labels.backend}%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "targetBlank": true}],
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(session_backend_operation_duration_ms_milliseconds_bucket[5m])) by (le, backend, operation))",
          "legendFormat": "p50 {{backend}} {{operation}}",
          "refId": "A"
        }
      ],
      "description": "tymux vs tmux, side by side. Operations: start/restore/attach/send_keys/write_stdin/capture_pane/resize."
    },
    {
      "id": 2,
      "title": "Operation latency p99 by backend + operation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": { "links": [{"title": "Slow (> 500ms) backend spans for this backend in Tempo (Explore)", "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.backend%20%3D%20%5C%22${__field.labels.backend}%5C%22%20%26%26%20duration%20%3E%20500ms%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "targetBlank": true}],
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(session_backend_operation_duration_ms_milliseconds_bucket[5m])) by (le, backend, operation))",
          "legendFormat": "p99 {{backend}} {{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Operation rate by backend + operation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": { "links": [{"title": "Backend lifecycle spans for this backend in Tempo (Explore)", "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.backend%20%3D%20%5C%22${__field.labels.backend}%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "targetBlank": true}],
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(session_backend_operation_duration_ms_milliseconds_count[5m])) by (backend, operation)",
          "legendFormat": "{{backend}} {{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Backend mix",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(session_backend_info) by (backend, source)",
          "legendFormat": "{{backend}} ({{source}})",
          "refId": "A"
        }
      ],
      "description": "Info-style gauge (value 1): which backend is in effect, and whether from the global default or a per-session override."
    },
    {
      "type": "row",
      "title": "tymux attach stream health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 101
    },
    {
      "id": 5,
      "title": "Stream reconnect rate by cause",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(tymux_attach_stream_reconnects_total[5m])) by (cause)",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ],
      "description": "cause=error is a transport drop that triggered ReconnectLoop; cause=output_gap is an in-stream resync."
    },
    {
      "id": 6,
      "title": "Attach events rate by kind",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(tymux_attach_events_total[5m])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Max heartbeat age across live streams",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(tymux_attach_heartbeat_age_seconds)",
          "legendFormat": "max age",
          "refId": "A"
        }
      ],
      "description": "Seconds since the most recent AttachEvent on the stalest live stream. Climbing without bound means a wedged stream."
    },
    {
      "type": "row",
      "title": "tymuxd supervision",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 102
    },
    {
      "id": 8,
      "title": "Daemon restarts (30m) by reason",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(tymux_daemon_restarts_total[30m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Daemon start duration p50 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(tymux_daemon_start_duration_ms_milliseconds_bucket[1h])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(tymux_daemon_start_duration_ms_milliseconds_bucket[1h])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Daemon version mismatch",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(tymux_daemon_version_mismatch)",
          "legendFormat": "mismatch",
          "refId": "A"
        }
      ],
      "description": "1 when the running tymuxd differs from the binary stapler-squad would spawn."
    },
    {
      "type": "row",
      "title": "Traces (Tempo)",
      "id": 201,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      }
    },
    {
      "id": 202,
      "title": "Slow backend and tymuxd spans (> 500ms)",
      "type": "table",
      "description": "session.backend.* lifecycle spans and tymux.v1.* client spans slower than 500ms (the long-lived Attach stream is excluded). Hot-path send_keys/write_stdin/capture_pane/resize are metric-only and will not appear here.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && (name =~ \"session.backend.*\" || name =~ \"tymux.v1.*\") && name != \"tymux.v1.TymuxService/Attach\" && duration > 500ms }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 203,
      "title": "Errored backend and tymuxd spans",
      "type": "table",
      "description": "session.backend.* and tymux.v1.* spans with status=error.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && (name =~ \"session.backend.*\" || name =~ \"tymux.v1.*\") && name != \"tymux.v1.TymuxService/Attach\" && status = error }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
