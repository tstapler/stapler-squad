{
  "title": "stapler-squad: session PR tracking",
  "description": "Polling cost, failures and the unverified-row drain of the multi-PR poller (session-multi-pr-tracking). alertRules are warning-level definitions for the operator's Grafana alerting; Grafana ignores the key when provisioning the dashboard. Cleanup-gate and adoption panels are added with the metrics from T4.2.3 and T5.4.x.",
  "uid": "ssq-session-pr-tracking",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "stapler-squad",
    "pr",
    "poller"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Polling cost and health",
      "id": 100,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "PR polls per hour (K10 request budget)",
      "type": "stat",
      "description": "Fetches of PullRequestState rows over the last hour. The 1,500 line is the planned budget; merged and closed PRs must stop appearing here.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(ssq_pr_poll_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Polls by PR state",
      "type": "timeseries",
      "description": "Per-state poll rate; `merged` and `closed` should be near zero.",
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (state) (rate(ssq_pr_poll_total[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Poll failures by reason",
      "type": "timeseries",
      "description": "Counted and non-counted failures: auth, rate_limited, repo_inaccessible, not_found, network.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (reason) (increase(ssq_pr_poll_failures_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Unverified terminal rows (K2 drain)",
      "type": "stat",
      "description": "Backfilled PRs still waiting for a first verification fetch. Should fall to zero after a boot.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "max(ssq_pr_unverified_terminal_rows)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Branch discovery list calls",
      "type": "stat",
      "description": "Branch-list calls made to find a new PR on a resolved session.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(ssq_pr_discovery_list_calls_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Session PR set",
      "id": 101,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 6,
      "title": "PRs per session on attach",
      "type": "timeseries",
      "description": "Distribution observed when a session attaches a PR.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (le) (rate(ssq_session_pr_count_bucket[$__rate_interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Legacy mirror drift",
      "type": "timeseries",
      "description": "Sessions whose stored legacy PR columns differed from the active-PR projection (kind=corrected) or were skipped as unrepresented.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (kind) (increase(ssq_session_pr_mirror_drift_total[1h]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    }
  ],
  "alertRules": [
    {
      "name": "SessionPRPollBudgetExceeded",
      "severity": "warning",
      "expr": "sum(increase(ssq_pr_poll_total[1h])) > 1500",
      "for": "2h",
      "summary": "PR polling exceeded the 1,500 requests/hour budget for two consecutive hours."
    },
    {
      "name": "SessionPRUnverifiedRowsLingering",
      "severity": "warning",
      "expr": "max(ssq_pr_unverified_terminal_rows) > 0",
      "for": "24h",
      "summary": "Backfilled PR rows have stayed unverified for more than 24 hours."
    }
  ]
}
