    {
      "type": "row",
      "title": "Listener and OS saturation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 204
    },
    {
      "id": 205,
      "title": "Accepts per second by listener",
      "description": "Connections accepted. A burst with flat request rate means the browser is opening connections instead of reusing them.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (listener)(rate(http_server_accepted_total[5m]))",
          "legendFormat": "{{listener}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 206,
      "title": "Accept and TLS handshake errors",
      "description": "Any fd_exhausted is a hard saturation signal: the process is at its descriptor limit. TLS handshake errors on remote are usually untrusted-cert clients.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (listener, kind)(rate(http_server_accept_errors_total[5m]))",
          "legendFormat": "accept {{listener}} {{kind}}",
          "refId": "A"
        },
        {
          "expr": "sum by (listener)(rate(http_server_tls_handshake_errors_total[5m]))",
          "legendFormat": "tls handshake {{listener}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 207,
      "title": "File descriptors vs limit",
      "description": "Open descriptors against the soft RLIMIT_NOFILE. Alert above 80% of limit. macOS counts by probing up to 32768.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "process_open_fds",
          "legendFormat": "open",
          "refId": "A"
        },
        {
          "expr": "process_fd_limit",
          "legendFormat": "limit",
          "refId": "B"
        }
      ]
    },
    {
      "id": 208,
      "title": "Kernel listen-queue pressure (Linux)",
      "description": "Nonzero overflow/drops means the accept loop could not keep up with the backlog. Absent on macOS: check `netstat -s -p tcp | grep -i listen` by hand; the somaxconn series still shows the cap.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(os_tcp_listen_overflows_total[5m])",
          "legendFormat": "listen overflows/s",
          "refId": "A"
        },
        {
          "expr": "rate(os_tcp_listen_drops_total[5m])",
          "legendFormat": "listen drops/s",
          "refId": "B"
        },
        {
          "expr": "os_tcp_somaxconn",
          "legendFormat": "somaxconn",
          "refId": "C"
        }
      ]
    },
    {
      "id": 209,
      "title": "Stream age at close (p50 / p95 by method)",
      "description": "Streams that close within seconds of opening are a reconnect storm; each one briefly holds one of the browser's 6 connections. Open count is rpc_server_streams_open.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, method)(rate(rpc_server_stream_age_seconds_bucket[15m])))",
          "legendFormat": "p50 {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method)(rate(rpc_server_stream_age_seconds_bucket[15m])))",
          "legendFormat": "p95 {{method}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 210,
      "title": "Time before the handler starts (p95 by class)",
      "description": "Request reaching the process to RPC handler start: middleware, guards, auth. Healthy is under 1ms; seconds means the request waited inside the process before any handler ran.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
