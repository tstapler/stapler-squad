        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, class)(rate(rpc_server_pre_handler_seconds_bucket[5m])))",
          "legendFormat": "p95 {{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 211,
      "title": "Client-aborted calls by method",
      "description": "Calls whose browser gave up (context canceled) before the handler finished: the server-side view of client timeouts and navigations. GetVCSStatus dominated the owner's HAR (15 of 18 aborts).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "datasource": {
