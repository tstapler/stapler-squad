{
  "title": "stapler-squad: HTTP/RPC connections",
  "description": "Connection saturation for stapler-squad's plain-HTTP/1.1 server — catches the browser's 6-connections-per-origin exhaustion bug class (see docs/how-to/enable-opentelemetry.md, 'Connection concurrency metrics').",
  "uid": "ssq-http-rpc-connections",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "iconColor": "green", "name": "Deploys", "target": { "limit": 100, "matchAny": false, "tags": ["deploy", "stapler-squad"], "type": "tags" }, "type": "tags" }
    ]
  },
  "links": [{"title": "Traces in Tempo (Explore)", "type": "link", "icon": "external link", "targetBlank": true, "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.rpc.system%20%3D%20%5C%22connect_rpc%5C%22%20%26%26%20kind%20%3D%20server%20%26%26%20name%20%21~%20%5C%22.%2AWatch.%2A%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "tooltip": "Open Grafana Explore on Tempo with this dashboard's time range"}, {"title": "Unary spans >2s in Tempo", "type": "link", "icon": "external link", "targetBlank": true, "url": "/explore?schemaVersion=1&orgId=1&panes={%22a%22%3A{%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22datasource%22%3A{%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22}%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22{%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.rpc.system%20%3D%20%5C%22connect_rpc%5C%22%20%26%26%20kind%20%3D%20server%20%26%26%20duration%20%3E%202s%20%26%26%20name%20%21~%20%5C%22.%2AWatch.%2A%5C%22%20}%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20}%5D%2C%22range%22%3A{%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22}}}", "tooltip": "Unary RPC server spans slower than 2s"}],
  "panels": [
    { "type": "row", "title": "Golden signals", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100 },
    {
      "id": 1,
      "title": "HTTP/1.1 connections open",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 6 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "http_server_connections_open", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "WebSocket upgrades (rate, 5m)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(http_server_connections_hijacked_total[5m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Open long-lived RPC streams (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(rpc_server_streams_open)", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "HTTP/1.1 connections open (trend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 6 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "http_server_connections_open", "legendFormat": "connections open", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "RPC streams open by method (Breakdown)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "links": [{"title": "Traces for this RPC method in Tempo (Explore)", "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.rpc.system%20%3D%20%5C%22connect_rpc%5C%22%20%26%26%20kind%20%3D%20server%20%26%26%20span.rpc.method%20%3D%20%5C%22${__field.labels.method}%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "targetBlank": true}], "unit": "short", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rpc_server_streams_open) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ]
    },
    { "type": "row", "title": "Context", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "id": 101 },
    {
      "id": 6,
      "title": "SIGKILL escalations (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "increase(safeexec_sigkill_escalations_total[1h])", "refId": "A" }]
    },
    {
      "type": "row",
      "title": "Traces (Tempo)",
      "id": 201,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 202,
      "title": "Slow RPC server spans (> 500ms, streams excluded)",
      "type": "table",
      "description": "Connect RPC handler spans from stapler-squad slower than 500ms. Watch* streams are excluded because they are long-lived by design. Click a trace id to open it in Tempo.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && span.rpc.system = \"connect_rpc\" && kind = server && name !~ \".*Watch.*\" && duration > 500ms }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 203,
      "title": "Errored RPC server spans",
      "type": "table",
      "description": "Connect RPC handler spans with status=error. See span attribute rpc.connect_rpc.error_code for the Connect code.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && span.rpc.system = \"connect_rpc\" && kind = server && name !~ \".*Watch.*\" && status = error }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {"type": "row", "title": "Saturation: accept queue, runtime, aborts (new)", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 316},
    {"id": 317, "title": "Accepts (/s) and accept errors by kind", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 33}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"expr": "sum by (listener)(rate(http_listener_accepts_total[5m]))", "refId": "A", "legendFormat": "accepts {{listener}}"}, {"expr": "sum by (listener, kind)(rate(http_listener_accept_errors_total[5m]))", "refId": "B", "legendFormat": "errors {{listener}} {{kind}}"}], "description": "kind=emfile means the process ran out of file descriptors (see FD panel)."},
    {"id": 318, "title": "Accepted connections open (incl. hijacked WebSockets)", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 33}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "http_listener_conns_open", "refId": "A", "legendFormat": "{{listener}}"}], "description": "Unlike http_server_connections_open this keeps hijacked connections; rising without bound = leak."},
    {"id": 319, "title": "Connection age at close p50 / p99", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 33}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "histogram_quantile(0.5, sum by (le, listener)(rate(http_listener_conn_age_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50 {{listener}}"}, {"expr": "histogram_quantile(0.99, sum by (le, listener)(rate(http_listener_conn_age_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p99 {{listener}}"}]},
    {"id": 320, "title": "Kernel listen overflows / drops (/s, Linux only)", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 40}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.001}]}}, "overrides": []}, "targets": [{"expr": "sum(rate(net_tcp_listen_overflows_total[5m]))", "refId": "A", "legendFormat": "overflows"}, {"expr": "sum(rate(net_tcp_listen_drops_total[5m]))", "refId": "B", "legendFormat": "drops"}], "description": "Any sustained non-zero rate = accept queue full; clients see stalled connects. macOS: not exported, run `netstat -s -p tcp | grep -i listen`."},
    {"id": 321, "title": "somaxconn (kernel backlog ceiling)", "type": "stat", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 40}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "net_tcp_somaxconn", "refId": "A"}], "description": "macOS default 128. Go listens with backlog=min(somaxconn, 65535)."},
    {"id": 322, "title": "TLS handshake errors (/s) and client-aborted unary calls (/s)", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 40}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"expr": "sum by (listener)(rate(http_listener_tls_handshake_errors_total[5m]))", "refId": "A", "legendFormat": "tls {{listener}}"}, {"expr": "topk(10, sum by (method)(rate(rpc_server_client_aborted_total[5m])))", "refId": "B", "legendFormat": "aborted {{method}}"}]},
    {"id": 323, "title": "File descriptors: open vs limit", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 47}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "process_open_fds", "refId": "A", "legendFormat": "open"}, {"expr": "process_fd_limit", "refId": "B", "legendFormat": "limit"}], "description": "Alert at open/limit > 0.8: accept() starts failing with EMFILE."},
    {"id": 324, "title": "In-flight RPC handlers by kind", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 47}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "sum by (kind)(rpc_server_inflight)", "refId": "A", "legendFormat": "{{kind}}"}], "description": "unary in-flight growing while request rate is flat = handlers stuck behind a saturated resource (DB pool, mutex)."},
    {"id": 325, "title": "Scheduler latency p50 / p99 (CPU starvation)", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 47}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.1}]}}, "overrides": []}, "targets": [{"expr": "go_sched_latency_p50_seconds", "refId": "A", "legendFormat": "p50"}, {"expr": "go_sched_latency_p99_seconds", "refId": "B", "legendFormat": "p99"}], "description": "Time runnable goroutines waited for a processor over the last scrape. p99 >10 ms = host CPU starved (load avg >> cores); every handler inflates by this."},
    {"id": 326, "title": "Goroutines / heap", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 54}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"expr": "go_sched_goroutines", "refId": "A", "legendFormat": "goroutines"}, {"expr": "go_heap_objects_bytes", "refId": "B", "legendFormat": "heap bytes"}]},
    {"id": 327, "title": "GC pause p99", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 54}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "go_gc_pause_p99_seconds", "refId": "A"}]},
    {"id": 328, "title": "sync.Mutex wait (s of blocking per second)", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 54}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "rate(go_sync_mutex_wait_seconds_total[5m])", "refId": "A"}], "description": "Goroutine-seconds blocked on Go mutexes per second; >1 means on average one goroutine is always blocked on a lock."}
  ]
}
