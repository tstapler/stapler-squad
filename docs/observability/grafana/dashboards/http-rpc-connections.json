{
  "title": "stapler-squad: HTTP/RPC connections",
  "description": "Connection saturation for stapler-squad's plain-HTTP/1.1 server — catches the browser's 6-connections-per-origin exhaustion bug class (see docs/how-to/enable-opentelemetry.md, 'Connection concurrency metrics').",
  "uid": "ssq-http-rpc-connections",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "annotations": {
    "list": [
      { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" },
      { "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "iconColor": "green", "name": "Deploys", "target": { "limit": 100, "matchAny": false, "tags": ["deploy", "stapler-squad"], "type": "tags" }, "type": "tags" }
    ]
  },
  "links": [{"title": "Traces in Tempo (Explore)", "type": "link", "icon": "external link", "targetBlank": true, "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.rpc.system%20%3D%20%5C%22connect_rpc%5C%22%20%26%26%20kind%20%3D%20server%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "tooltip": "Open Grafana Explore on Tempo with this dashboard's time range"}],
  "panels": [
    { "type": "row", "title": "Golden signals", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100 },
    {
      "id": 1,
      "title": "HTTP/1.1 connections open",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 6 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "http_server_connections_open", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "WebSocket upgrades (rate, 5m)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(http_server_connections_hijacked_total[5m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Open long-lived RPC streams (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(rpc_server_streams_open)", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "HTTP/1.1 connections open (trend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 5 },
            { "color": "red", "value": 6 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "http_server_connections_open", "legendFormat": "connections open", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "RPC streams open by method (Breakdown)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "links": [{"title": "Traces for this RPC method in Tempo (Explore)", "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.service.name%20%3D%20%5C%22stapler-squad%5C%22%20%26%26%20span.rpc.method%20%3D%20%5C%22${__field.labels.method}%5C%22%20%7D%22%2C%22tableType%22%3A%22traces%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22${__from}%22%2C%22to%22%3A%22${__to}%22%7D%7D%7D", "targetBlank": true}], "unit": "short", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rpc_server_streams_open) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ]
    },
    { "type": "row", "title": "Context", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "id": 101 },
    {
      "id": 6,
      "title": "SIGKILL escalations (1h)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [{ "expr": "increase(safeexec_sigkill_escalations_total[1h])", "refId": "A" }]
    },
    {
      "type": "row",
      "title": "Traces (Tempo)",
      "id": 201,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 202,
      "title": "Slow RPC server spans (> 500ms, streams excluded)",
      "type": "table",
      "description": "Connect RPC handler spans from stapler-squad slower than 500ms. Watch* streams are excluded because they are long-lived by design. Click a trace id to open it in Tempo.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && span.rpc.system = \"connect_rpc\" && kind = server && name !~ \".*Watch.*\" && duration > 500ms }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 203,
      "title": "Errored RPC server spans (excluding canceled)",
      "type": "table",
      "description": "Connect RPC handler spans with status=error, excluding client-canceled calls. See span attribute rpc.connect_rpc.error_code for the Connect code.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"stapler-squad\" && span.rpc.system = \"connect_rpc\" && kind = server && status = error && span.rpc.connect_rpc.error_code != \"canceled\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
