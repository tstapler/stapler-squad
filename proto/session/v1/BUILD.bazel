# TypeScript half of buf.gen.yaml as a tree artifact equal to web-app/src/gen (bazel-bin/proto/session/v1/ts).
# protoc-gen-es comes from the pinned Bun install (ADR-003). The consuming web actions carry
# no-remote-cache because that install is not proven byte-reproducible (Story 7.7); the action carries it too.
buf_gen_ts(
    name = "session_ts",
    srcs = [":protos"],
    out = "ts",
    buf = "@com_github_bufbuild_buf//cmd/buf",
    buf_yaml = "//:buf.yaml",
    node = "@node_host//:node",
    node_modules = "@web_node_modules//:node_modules",
    template = "//:buf.gen.bazel-ts.yaml",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "protos",
    srcs = glob(["*.proto"]),
    visibility = ["//visibility:public"],
)

# buf lint (STANDARD, buf.yaml) as hermetic tests with the Go-built buf (no rules_buf toolchain, no
# network). Findings listed in the baseline are tolerated (owner decision pending); anything new fails
# with its rule name, and a baseline entry that stops firing fails too (ratchet).
_BUF_LINT_ARGS = [
    "$(rootpath @com_github_bufbuild_buf//cmd/buf)",
    "$(rootpath //:buf.yaml)",
    "$(rootpath //tools/bzl/proto:buf-lint-baseline.txt)",
    "$(rootpaths :protos)",
]

_BUF_LINT_DATA = [
    ":protos",
    "//:buf.yaml",
    "//tools/bzl/proto:buf-lint-baseline.txt",
    "@com_github_bufbuild_buf//cmd/buf",
]

sh_test(
    name = "buf_lint_test",
    srcs = ["//tools/bzl/proto:buf_lint.sh"],
    args = _BUF_LINT_ARGS,
    data = _BUF_LINT_DATA,
)

sh_test(
    name = "buf_lint_seeded_test",
    srcs = ["//tools/bzl/proto:buf_lint.sh"],
    args = ["--seeded"] + _BUF_LINT_ARGS,
    data = _BUF_LINT_DATA,
)

sh_binary(
    name = "buf_lint_update_baseline",
    srcs = ["//tools/bzl/proto:buf_lint.sh"],
    args = ["--update"] + _BUF_LINT_ARGS,
    data = _BUF_LINT_DATA,
)
