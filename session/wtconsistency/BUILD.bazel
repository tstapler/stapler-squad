load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "wtconsistency",
    srcs = ["sweep.go"],
    importpath = "github.com/tstapler/stapler-squad/session/wtconsistency",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//tools/bzl/ent",
        "//tools/bzl/ent:session",
        "//tools/bzl/ent:worktree",
        "@com_github_go_git_go_git_v5//plumbing",
    ],
)

alias(
    name = "go_default_library",
    actual = ":wtconsistency",
    visibility = ["//visibility:public"],
)

go_test(
    name = "wtconsistency_test",
    srcs = ["sweep_test.go"],
    embed = [":wtconsistency"],
    deps = [
        "//config",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//session/internal/sessiontest",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
