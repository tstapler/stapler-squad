load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "analyticsstore",
    srcs = ["analytics.go"],
    importpath = "github.com/tstapler/stapler-squad/session/analyticsstore",
    visibility = ["//visibility:public"],
    deps = [
        "//session/domain",
        "//tools/bzl/ent",
        "//tools/bzl/ent:classificationanalytics",
        "//tools/bzl/ent:dismissedfinding",
        "//tools/bzl/ent:predicate",
    ],
)

alias(
    name = "go_default_library",
    actual = ":analyticsstore",
    visibility = ["//visibility:public"],
)

go_test(
    name = "analyticsstore_test",
    srcs = ["analytics_test.go"],
    embed = [":analyticsstore"],
    deps = [
        "//session/domain",
        "//session/internal/entdbtest",
        "//tools/bzl/ent:dismissedfinding",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by session's and server/services' Bazel-sandboxed source scanners.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
