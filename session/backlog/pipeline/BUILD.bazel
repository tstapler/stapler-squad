load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "pipeline",
    srcs = [
        "attached_images.go",
        "commands.go",
        "context.go",
        "engine.go",
        "review.go",
        "triage.go",
        "wake_prompt.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/backlog/pipeline",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//github",
        "//log",
        "//pkg/threatscan",
        "//session",
        "//session/backlog/stuck",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//session/git/backend",
        "//session/gitprovider",
        "//session/headless",
        "//session/vc",
        "@com_github_google_uuid//:uuid",
    ],
)

alias(
    name = "go_default_library",
    actual = ":pipeline",
    visibility = ["//visibility:public"],
)

go_test(
    name = "pipeline_test",
    srcs = [
        "attached_images_test.go",
        "commands_bk_test.go",
        "context_bk_test.go",
        "engine_bk_test.go",
        "engine_characterization_test.go",
        "mode_validation_bk_test.go",
        "post_review_prompt_test.go",
        "prompt_sections_bk_test.go",
        "refs_backend_bk_test.go",
        "review_bk_test.go",
        "triage_test.go",
        "wake_prompt_test.go",
    ],
    data = glob(["*.go"]) + ["//session/backlog/pipeline/testdata:all"],
    embed = [":pipeline"],
    deps = [
        "//envtest",
        "//executor/safeexec",
        "//session",
        "//session/backlog/internal/blktest",
        "//session/domain/backlogdto",
        "//session/git/backend",
        "//session/headless",
        "//session/internal/sessiontest",
        "//testutil/gitfake",
        "//tools/bzl/ent",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by session and server/services tests that scan Go sources repo-wide.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
