        "definition.go",
        "engine.go",
        "ent_repository.go",
        "repository.go",
        "staleness.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/backlog/liveness",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//session",
        "//session/backlog/stuck",
