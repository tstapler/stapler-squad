load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "backlog",
    srcs = [
        "backlog_lifecycle.go",
        "backlog_lifecycle_archive.go",
        "backlog_lifecycle_gates.go",
        "backlog_lifecycle_live_work.go",
        "backlog_lifecycle_noop.go",
        "backlog_lifecycle_pr.go",
        "backlog_lifecycle_review.go",
        "backlog_lifecycle_stale.go",
        "backlog_lifecycle_triage.go",
        "ci_flaky_rerun.go",
        "pr_terminal_listener.go",
        "stuck_detectors.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/backlog",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//github",
        "//log",
        "//session",
        "//session/backlog/chains",
        "//session/backlog/liveness",
        "//session/backlog/pipeline",
        "//session/backlog/reviewgate",
        "//session/backlog/stuck",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//session/headless",
        "//session/hostclaim",
        "//tools/bzl/ent",
        "@com_github_google_uuid//:uuid",
    ],
)

alias(
    name = "go_default_library",
    actual = ":backlog",
    visibility = ["//visibility:public"],
)

go_test(
    name = "backlog_test",
    srcs = [
        "background_outcome_bk_test.go",
        "backlog_denied_guard_bk_test.go",
        "backlog_integration_bk_test.go",
        "backlog_item_prs_fixture_test.go",
        "backlog_lifecycle_archive_bk_test.go",
        "backlog_lifecycle_bk_test.go",
        "backlog_lifecycle_enabled_test.go",
        "backlog_lifecycle_engine_guard_test.go",
        "backlog_lifecycle_gates_test.go",
        "backlog_lifecycle_live_work_test.go",
        "backlog_lifecycle_noop_test.go",
        "backlog_lifecycle_pr_branch_guard_test.go",
        "backlog_lifecycle_pr_characterization_test.go",
        "backlog_lifecycle_pr_test.go",
        "backlog_lifecycle_pr_trigger_test.go",
        "backlog_lifecycle_stuck_test.go",
        "backlog_lifecycle_superseded_test.go",
        "backlog_remediation_bk_test.go",
        "backlog_spawn_failed_test.go",
        "backlog_storage_pr_listener_test.go",
        "ci_flaky_rerun_test.go",
        "ent_repository_backlog_bk_test.go",
        "helpers_test.go",
        "liveness_characterization_test.go",
        "pr_terminal_listener_test.go",
        "refs_backend_bk_test.go",
        "review_spawn_guard_bk_test.go",
        "stuck_detectors_test.go",
        "twins_bk_test.go",
        "workflow_engine_soak_bk_test.go",
        "workflow_engine_soak_seeded_test.go",
    ],
    data = glob(["*.go"]),
    embed = [":backlog"],
    deps = [
        "//executor/safeexec",
        "//github",
        "//log",
        "//session",
        "//session/backlog/internal/blktest",
        "//session/backlog/liveness",
        "//session/backlog/pipeline",
        "//session/backlog/reviewgate",
        "//session/backlog/stuck",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/git",
        "//session/git/backend",
        "//session/headless",
        "//session/hostclaim",
        "//session/internal/sessiontest",
        "//testutil/gitfake",
        "//testutil/wait",
        "//tools/bzl/ent",
        "//tools/bzl/ent:backlogstage",
        "//tools/bzl/ent:backlogstuckstate",
        "//tools/bzl/ent:stagetransition",
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//config",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by session and server/services tests that scan the backlog lifecycle sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
