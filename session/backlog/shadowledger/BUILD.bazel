go_test(
    name = "shadowledger_test",
    srcs = [
        "fixtures_test.go",
        "shadowledger_test.go",
    ],
    embed = [":shadowledger"],
    deps = [
        "//config",
        "//session",
        "//session/domain",
        "//session/internal/sessiontest",
        "//tools/bzl/ent",
        "//tools/bzl/ent:backlogstage",
        "//tools/bzl/ent:stagetransition",
        "@com_github_stretchr_testify//require",
    ],
