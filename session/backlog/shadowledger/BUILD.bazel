load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "shadowledger",
    srcs = ["shadowledger.go"],
    importpath = "github.com/tstapler/stapler-squad/session/backlog/shadowledger",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "//session",
        "//session/domain",
        "//session/hostclaim",
