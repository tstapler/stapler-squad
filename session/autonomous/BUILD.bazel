load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "autonomous",
    srcs = [
        "autonomous_driver.go",
        "autonomous_stall_nudge.go",
        "autonomous_stop_snapshot.go",
        "health.go",
        "idle_status_gate.go",
        "nudge_dedup.go",
        "nudge_gate.go",
        "review_transcript.go",
        "testing.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/autonomous",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//pkg/ansi",
        "//session",
        "//session/claudectl",
        "//session/detection",
        "//session/detection/ratelimit",
        "//session/domain",
        "//session/headless",
        "//session/instance",
        "//session/scrollback",
        "//session/tmux",
        "@com_github_linkdata_deadlock//:deadlock",
    ],
)

alias(
    name = "go_default_library",
    actual = ":autonomous",
    visibility = ["//visibility:public"],
)

go_test(
    name = "autonomous_test",
    srcs = [
        "autonomous_driver_stop_test.go",
        "autonomous_driver_test.go",
        "autonomous_stall_nudge_test.go",
        "autonomous_stop_snapshot_test.go",
        "health_deadpane_snapshot_test.go",
        "health_test.go",
        "helpers_test.go",
        "main_test.go",
        "nudge_dedup_test.go",
        "nudge_gate_settle_window_test.go",
        "nudge_gate_wiring_test.go",
        "review_transcript_test.go",
    ],
    embed = [":autonomous"],
    deps = [
        "//session",
        "//session/claudectl",
        "//session/claudectl/claudectltest",
        "//session/detection",
        "//session/detection/ratelimit",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/headless",
        "//session/instance",
        "//session/internal/fixturetest",
        "//session/internal/sessiontest",
        "//session/scrollback",
        "//session/tmux",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
