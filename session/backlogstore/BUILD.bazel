load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "backlogstore",
    srcs = [
        "dependency_queries.go",
        "dependency_writers.go",
        "hooks.go",
        "item_queries.go",
        "item_session_queries.go",
        "item_session_updates.go",
        "lookup.go",
        "mappers.go",
        "progress_notes.go",
        "sources.go",
        "store.go",
        "stuck_queries.go",
        "stuck_writers.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/backlogstore",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//session/domain",
        "//session/domain/backlogdto",
        "//session/markerstore",
        "//tools/bzl/ent",
        "//tools/bzl/ent:acauditevent",
        "//tools/bzl/ent:backlogactivitynote",
        "//tools/bzl/ent:backlogitem",
        "//tools/bzl/ent:backlogitemdependency",
        "//tools/bzl/ent:backlogprogressnote",
        "//tools/bzl/ent:backlogstatusevent",
        "//tools/bzl/ent:backlogstuckstate",
        "//tools/bzl/ent:itemsession",
        "//tools/bzl/ent:itemsource",
        "//tools/bzl/ent:predicate",
        "//tools/bzl/ent:session",
        "//tools/bzl/ent:sourcesyncevent",
        "@com_github_google_uuid//:uuid",
    ],
)

alias(
    name = "go_default_library",
    actual = ":backlogstore",
    visibility = ["//visibility:public"],
)

go_test(
    name = "backlogstore_test",
    srcs = ["hooks_test.go"],
    embed = [":backlogstore"],
    deps = [
        "//session/domain/backlogdto",
        "@com_github_stretchr_testify//assert",
    ],
)

# Read by session's legacy item-PR reader scan and server/services' workflow-bypass scanners.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
