load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "slowops",
    srcs = [
        "call.go",
        "recorder.go",
        "watchdog.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/slowops",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/termlat",
        "//log",
        "//telemetry",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

alias(
    name = "go_default_library",
    actual = ":slowops",
    visibility = ["//visibility:public"],
)

go_test(
    name = "slowops_test",
    srcs = [
        "call_test.go",
        "recorder_test.go",
        "watchdog_test.go",
    ],
    embed = [":slowops"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
