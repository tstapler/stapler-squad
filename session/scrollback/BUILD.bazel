load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "scrollback",
    srcs = [
        "buffer.go",
        "fork.go",
        "manager.go",
        "storage.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/scrollback",
    visibility = ["//visibility:public"],
    deps = ["@com_github_klauspost_compress//zstd"],
)

alias(
    name = "go_default_library",
    actual = ":scrollback",
    visibility = ["//visibility:public"],
)

go_test(
    name = "scrollback_test",
    srcs = [
        "buffer_bench_test.go",
        "buffer_test.go",
        "fork_test.go",
        "manager_test.go",
        "storage_test.go",
    ],
    embed = [":scrollback"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
