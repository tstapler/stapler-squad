load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "redact",
    srcs = ["redact.go"],
    importpath = "github.com/tstapler/stapler-squad/session/git/redact",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":redact",
    visibility = ["//visibility:public"],
)

go_test(
    name = "redact_test",
    srcs = ["redact_test.go"],
    embed = [":redact"],
)

# Read by session/unfinished tests that walk the in-module import graph with go/build.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//session/unfinished:__subpackages__"],
)
