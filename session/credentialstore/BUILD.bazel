load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "credentialstore",
    srcs = ["credentials.go"],
    importpath = "github.com/tstapler/stapler-squad/session/credentialstore",
    visibility = ["//visibility:public"],
    deps = [
        "//session/domain",
        "//tools/bzl/ent",
        "//tools/bzl/ent:integrationcredential",
    ],
)

alias(
    name = "go_default_library",
    actual = ":credentialstore",
    visibility = ["//visibility:public"],
)

go_test(
    name = "credentialstore_test",
    srcs = ["credentials_test.go"],
    embed = [":credentialstore"],
    deps = [
        "//session/domain",
        "//session/internal/entdbtest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
