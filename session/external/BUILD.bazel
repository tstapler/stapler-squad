load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "external",
    srcs = [
        "external_approval.go",
        "external_discovery.go",
        "external_tmux_streamer.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/external",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//log",
        "//session",
        "//session/detection",
        "//session/domain",
        "//session/instance",
        "//session/mux",
        "//session/tmux",
        "@com_github_google_uuid//:uuid",
        "@com_github_linkdata_deadlock//:deadlock",
    ],
)

alias(
    name = "go_default_library",
    actual = ":external",
    visibility = ["//visibility:public"],
)

go_test(
    name = "external_test",
    srcs = ["external_discovery_test.go"],
    embed = [":external"],
    deps = [
        "//config",
        "//session",
        "//session/domain",
        "//session/instance",
        "//session/mux",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
