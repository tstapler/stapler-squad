load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "deeplink",
    srcs = ["url.go"],
    importpath = "github.com/tstapler/stapler-squad/session/deeplink",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":deeplink",
    visibility = ["//visibility:public"],
)

go_test(
    name = "deeplink_test",
    srcs = ["url_test.go"],
    embed = [":deeplink"],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
