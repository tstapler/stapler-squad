load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "jules",
    srcs = ["session_poller.go"],
    importpath = "github.com/tstapler/stapler-squad/session/jules",
    visibility = ["//visibility:public"],
    deps = [
        "//jules",
        "//log",
        "//session",
        "//session/domain/backlogdto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":jules",
    visibility = ["//visibility:public"],
)

go_test(
    name = "jules_test",
    srcs = [
        "helpers_test.go",
        "session_poller_test.go",
    ],
    data = [
        "//:go.mod",
        "//jules:types.go",
    ],
    embed = [":jules"],
    deps = [
        "//internal/reporoot",
        "//jules",
        "//log",
        "//session",
        "//session/domain",
        "//session/domain/backlogdto",
        "@com_github_google_uuid//:uuid",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by session and server/services tests that scan the Jules poller's transition sites.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
