load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "memorytest",
    srcs = ["fake.go"],
    importpath = "github.com/tstapler/stapler-squad/session/memory/memorytest",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":memorytest",
    visibility = ["//visibility:public"],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
