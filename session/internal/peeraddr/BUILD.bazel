load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "peeraddr",
    srcs = ["peeraddr.go"],
    importpath = "github.com/tstapler/stapler-squad/session/internal/peeraddr",
    visibility = ["//session:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":peeraddr",
    visibility = ["//session:__subpackages__"],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
