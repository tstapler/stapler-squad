load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "workspace",
    srcs = [
        "lock.go",
        "lock_noop.go",
        "lock_postgres.go",
        "lock_sqlite.go",
        "notify.go",
        "notify_postgres.go",
        "registry.go",
        "types.go",
        "vcs_batch.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/workspace",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//session/domain",
        "//session/vc",
    ],
)

alias(
    name = "go_default_library",
    actual = ":workspace",
    visibility = ["//visibility:public"],
)

go_test(
    name = "workspace_test",
    srcs = [
        "lock_postgres_test.go",
        "lock_sqlite_test.go",
        "lock_test.go",
        "registry_test.go",
    ],
    embed = [":workspace"],
    deps = [
        "//log",
        "//session/domain",
        "@com_github_data_dog_go_sqlmock//:go-sqlmock",
    ],
)
