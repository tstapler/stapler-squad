load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "artifacts",
    srcs = [
        "caps.go",
        "classify.go",
        "extractor.go",
        "jsonl.go",
        "jsonl_flags.go",
        "metrics.go",
        "pairing.go",
        "records.go",
        "records_extract.go",
        "redact.go",
        "scan.go",
        "store.go",
        "types.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/artifacts",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//session/domain",
        "//session/scanqueue",
        "//session/scanstate",
        "//telemetry",
        "@io_opentelemetry_go_otel_metric//:metric",
