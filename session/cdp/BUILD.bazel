    visibility = ["//visibility:public"],
)

go_test(
    name = "cdp_test",
    srcs = [
        "deps_check_test.go",
        "inspect_test.go",
        "manager_test.go",
        "reconcile_isolation_test.go",
        "screencast_test.go",
    ],
    embed = [":cdp"],
    deps = [
        "@com_github_gorilla_websocket//:websocket",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
