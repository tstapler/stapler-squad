load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "cdp",
    srcs = [
        "deps_check.go",
        "inspect.go",
        "manager.go",
        "types.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/cdp",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//log",
        "@com_github_gorilla_websocket//:websocket",
