load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "mux",
    srcs = [
        "autodiscover.go",
        "discovery.go",
        "hooks.go",
        "multiplexer.go",
        "picker.go",
        "protocol.go",
        "signals_unix.go",
        "signals_windows.go",
        "socket_registry.go",
        "tmux_options.go",
        "tmux_socket.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/mux",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//executor/safeexec",
        "//pkg/localtoken",
        "//session/tmux",
