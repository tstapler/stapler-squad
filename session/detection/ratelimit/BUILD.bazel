load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "ratelimit",
    srcs = [
        "detector.go",
        "integration.go",
        "manager.go",
        "recovery.go",
        "scheduler.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/session/detection/ratelimit",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//pkg/ansi",
    ],
)

alias(
    name = "go_default_library",
    actual = ":ratelimit",
    visibility = ["//visibility:public"],
)

go_test(
    name = "ratelimit_test",
    srcs = [
        "detector_test.go",
        "integration_test.go",
    ],
    embed = [":ratelimit"],
    deps = ["//testutil/wait"],
)
