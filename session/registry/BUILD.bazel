load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "registry",
    srcs = ["registry.go"],
    importpath = "github.com/tstapler/stapler-squad/session/registry",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "//session/domain",
        "//session/instance",
    ],
)

alias(
    name = "go_default_library",
    actual = ":registry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "registry_test",
    srcs = ["registry_retention_test.go"],
    embed = [":registry"],
    deps = [
        "//session/instance",
        "@com_github_stretchr_testify//require",
    ],
)

# Read by the Bazel-sandboxed source-scanning guard tests (tools/bzl/scandata).
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//server/services:__pkg__",
        "//session:__pkg__",
    ],
)
