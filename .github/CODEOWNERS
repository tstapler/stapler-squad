# Owner-controlled files for the Bazel build (project_plans/bazel-conversion). Review is
# enforced only if branch protection requires code-owner review (decision D-PROTECT-MERGE),
# so the attestation gate does not rely on this file alone.
/project_plans/bazel-conversion/implementation/owner-attestations.yaml  @tstapler
/tools/bzl/parity/  @tstapler
/.github/workflows/bazel-parity.yml  @tstapler
/.github/workflows/bazel.yml  @tstapler
/MODULE.bazel  @tstapler
/.bazelrc  @tstapler
/tools/bzl/  @tstapler
/tools/bazel  @tstapler
*.bzl  @tstapler
# Root BUILD.bazel holds the `# gazelle:` directives; never treated as generated.
/BUILD.bazel  @tstapler
# Reviewability (Story 11.6): upgrade canary, fork register and the hand-written BUILD list.
/.github/workflows/bazel-upgrade-canary.yml  @tstapler
/docs/reference/bazel-forks.md  @tstapler
/.gitattributes  @tstapler

# Review authority for the promo guard code and its gate inputs. Guard inputs are
# read from the base blob, so changes here take effect after merge. List individual
# user logins (not only teams): GITHUB_TOKEN cannot resolve team membership, and
# `mediaguard` honours the allow-media label only for users named on the
# .github/promo-flags.json entry. Add a login to these entries before the first review that needs it.
/.github/promo-flags.json @tstapler
/tools/promo/** @tstapler
/tools/promolib/** @tstapler
/tools/docscoverage/** @tstapler
/docs/registry/docs-coverage/ @tstapler
/tools/promo/mediaguard/allowlist.txt @tstapler
/tools/promo/termcheck/allowlist.txt @tstapler
/.github/workflows/backlog-scaffolding-guard.yml @tstapler
/.github/workflows/deploy-website.yml @tstapler

# Theme files: a change needs the owner's review (the recorded sign-off for imagery,
# logos and decorative art that the OCR gate cannot read; Task 2.4.1f).
/web-app/src/styles/theme* @tstapler
/web-app/src/lib/theme/** @tstapler
/website/src/styles/grimdark.css @tstapler
/web-app/src/app/fonts/** @tstapler
/.github/workflows/website-ci.yml @tstapler
