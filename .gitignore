.idea
.aider*
.claude/settings.local.json
stapler-squad
stapler-squad.prev
claude-squad
claude-mux
ssq-hooks
_CodeSignature/
**.DS_Store
cs
stapler-squad-test

# Override global gitignore: track source files in directories named "logs"
!web-app/src/**/logs/
!web-app/src/**/logs/**

# Generated protocol buffer code — regenerate with: make proto-gen (or buf generate proto).
# NEVER force-add (git add -f) files under these paths, even to "fix" a build. Every
# make target that consumes generated code (build, test, lint) already depends on
# proto-gen; CI generates fresh before every consuming step. Committing these files
# has caused real breakage twice: once by force-adding a stale/incomplete generation,
# once by a CI workflow step ordering bug that only "worked" because these were
# force-added in the first place (see PR #445 and CI job "no-checked-in-generated-protos").
gen/
web/src/gen/
web-app/src/gen/
.proto-gen.stamp

# ent ORM generated code — regenerate with: make ent-gen (or go generate ./session/ent/)
# schema/ and generate.go are hand-written and must remain tracked.
session/ent/*.go
!session/ent/generate.go
session/ent/*/
!session/ent/schema/
.ent-gen.stamp
/web-app/.next
/web-app/node_modules/
/web-app/out/
/web-app/storybook-static/
/web-app/.env.local
/server/web/dist/
/.playwright-mcp
/tools/ci-gates/node_modules/

# worktrees
worktrees/

# outputs
coverage.out
coverage.html
cov_*.out
coverage_*.out
*.test
web-app/tsconfig.tsbuildinfo
test-results/
tests/playwright-report/
tests/test-results/
tests/test-results.json

# Playwright test artifacts
assets/demo-recording/.last-run.json
assets/demo-recording/demo-Demo-Flow-chromium/
tests/e2e/allure-results/
tests/e2e/allure-report/
tests/e2e/playwright-report/
tests/e2e/playwright-report-dev-mode/
tests/e2e/test-results/
tests/e2e/node_modules/
tests/e2e/test-results-dev-mode/
tests/e2e/fixtures/*-theme.json

# Scratch benchmark output files (not the committed baselines in benchmarks/go/)
bench-current.txt
bench-diff.txt
benchmark_results.txt
/web-app/out/
/server/web/dist/

# Build artifacts
build/

# Pinned tmux build stamp (third_party/tmux itself is a real git submodule now,
# so its contents don't need ignore rules).
.tmux-build.stamp

# Scanner build artifacts
tools/scanner/cmd
tools/scanner/backend/cmd/scanner

# Custom lint tool binaries
bin/
tools/lint/hotpolllog/hotpolllog
coverage.html

# Monolithic registry files — generated aggregates, not source of truth.
# Source of truth: docs/registry/features/<backend|frontend>/<domain>/<action>.json
docs/registry/backend-features.json
docs/registry/frontend-features.json
docs/registry/coverage-gaps.json

# Uploaded files (user-supplied, not source)
uploads/

# Benchmark baselines — persisted via GitHub Actions cache (see
# .github/workflows/benchmark.yml / build.yml's benchmark-gate job), not
# committed. A prior version committed these on every push to main, which
# flooded the commit history for very little value.
benchmarks/

# Backlog context files injected into worktrees — never source files
.backlog-context.md
.claude/commands/backlog/

# Runtime session-data artifacts leaked into the repo root by local dev runs
/session/*/scrollback.jsonl.zst
