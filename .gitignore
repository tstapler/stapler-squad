# Override global gitignore: track source files in directories named "logs"
!web-app/src/**/logs/
!web-app/src/**/logs/**

# Generated protocol buffer code
gen/
web/src/gen/
web-app/src/gen/
.proto-gen.stamp

# ent ORM generated code — regenerate with: go generate ./session/ent/
# schema/ and generate.go are hand-written and must remain tracked.
session/ent/*.go
!session/ent/generate.go
session/ent/*/
!session/ent/schema/
/web-app/.next
/web-app/node_modules/
/web-app/out/
/web-app/storybook-static/
/server/web/dist/
/.playwright-mcp

# worktrees
worktrees/

# outputs
coverage.out
coverage.html
cov_*.out
coverage_*.out
*.test
web-app/tsconfig.tsbuildinfo
test-results/
tests/playwright-report/
tests/test-results/
tests/test-results.json

# Playwright test artifacts
assets/demo-recording/.last-run.json
assets/demo-recording/demo-Demo-Flow-chromium/
tests/e2e/allure-results/
tests/e2e/allure-report/
tests/e2e/playwright-report/
tests/e2e/test-results/

# Scratch benchmark output files (not the committed baselines in benchmarks/go/)
bench-current.txt
bench-diff.txt
benchmark_results.txt
/web-app/out/
/server/web/dist/

# Build artifacts
build/

# Scanner build artifacts
tools/scanner/cmd
tools/scanner/backend/cmd/scanner

# Custom lint tool binaries
bin/
tools/lint/hotpolllog/hotpolllog
coverage.html

# Monolithic registry files — generated aggregates, not source of truth.
# Source of truth: docs/registry/features/<backend|frontend>/<domain>/<action>.json
docs/registry/backend-features.json
docs/registry/frontend-features.json
docs/registry/coverage-gaps.json

# Uploaded files (user-supplied, not source)
uploads/
