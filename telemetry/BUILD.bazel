load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "telemetry",
    srcs = [
        "attributes.go",
        "cgroup_linux.go",
        "cgroup_other.go",
        "goruntime.go",
        "latency_views.go",
        "runtime_contention.go",
        "telemetry.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/telemetry",
    visibility = ["//visibility:public"],
    deps = [
        "//log",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//propagation",
        "@io_opentelemetry_go_otel//semconv/v1.41.0:v1_41_0",
        "@io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc//:otlpmetricgrpc",
        "@io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc//:otlptracegrpc",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_sdk//resource",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//exemplar",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

alias(
    name = "go_default_library",
    actual = ":telemetry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "telemetry_test",
    srcs = [
        "attributes_test.go",
        "cgroup_linux_test.go",
        "goruntime_test.go",
        "latency_views_test.go",
        "runtime_contention_test.go",
        "telemetry_test.go",
    ],
    embed = [":telemetry"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_otel_sdk//trace",
        "@io_opentelemetry_go_otel_sdk//trace/tracetest",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//exemplar",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

# Read by session/unfinished tests that walk the in-module import graph with go/build.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = [
        "//session:__pkg__",
        "//session/unfinished:__subpackages__",
    ],
)
