load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "seed-hidden_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tests/e2e/seed-hidden",
    visibility = ["//visibility:private"],
    deps = [
        "//session",
        "//session/domain",
    ],
)

go_binary(
    name = "seed-hidden",
    embed = [":seed-hidden_lib"],
    visibility = ["//visibility:public"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
