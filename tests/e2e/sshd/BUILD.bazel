load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "sshd_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tests/e2e/sshd",
    visibility = ["//visibility:private"],
    deps = [
        "//executor/safeexec",
        "@com_github_gliderlabs_ssh//:ssh",
        "@org_golang_x_crypto//ssh",
    ],
)

go_binary(
    name = "sshd",
    embed = [":sshd_lib"],
    visibility = ["//visibility:public"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
