load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "demo",
    srcs = ["helpers.go"],
    importpath = "github.com/tstapler/stapler-squad/tests/demo",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//session",
        "//session/domain",
    ],
)

alias(
    name = "go_default_library",
    actual = ":demo",
    visibility = ["//visibility:public"],
)

go_test(
    name = "demo_test",
    srcs = ["demo_test.go"],
    embed = [":demo"],
    deps = ["//executor/safeexec"],
)

exports_files(["helpers.go"])

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
