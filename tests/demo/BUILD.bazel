load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "demo",
    srcs = ["helpers.go"],
    importpath = "github.com/tstapler/stapler-squad/tests/demo",
    visibility = ["//visibility:public"],
    deps = [
        "//executor/safeexec",
        "//session",
