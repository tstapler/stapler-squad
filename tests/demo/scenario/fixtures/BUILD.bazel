load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "fixtures",
    srcs = ["fixtures.go"],
    importpath = "github.com/tstapler/stapler-squad/tests/demo/scenario/fixtures",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//plumbing/object",
    ],
