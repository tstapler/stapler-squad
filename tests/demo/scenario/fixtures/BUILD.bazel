alias(
    name = "go_default_library",
    actual = ":fixtures",
    visibility = ["//visibility:public"],
)

go_test(
    name = "fixtures_test",
    srcs = ["fixtures_test.go"],
    embed = [":fixtures"],
    deps = ["@com_github_go_git_go_git_v5//:go-git"],
)
