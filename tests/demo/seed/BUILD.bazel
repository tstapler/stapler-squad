load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "seed_lib",
    srcs = [
        "main.go",
        "records.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tests/demo/seed",
    visibility = ["//visibility:private"],
    deps = [
        "//session",
        "//session/domain",
        "//tests/demo",
        "//tests/demo/scenario",
    ],
)

go_binary(
    name = "seed",
    embed = [":seed_lib"],
    visibility = ["//visibility:public"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
