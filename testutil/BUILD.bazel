    name = "go_default_library",
    actual = ":testutil",
    visibility = ["//visibility:public"],
)

go_test(
    name = "testutil_test",
    srcs = [
        "expect_test.go",
        "tmux_integration_test.go",
        "tmux_polling_test.go",
        "tmux_test.go",
        "tui_exit_test.go",
        "tui_session_creation_test.go",
        "tui_shutdown_diagnostic_test.go",
    ],
    embed = [":testutil"],
    deps = [
        "//executor/safeexec",
        "//testutil/wait",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
