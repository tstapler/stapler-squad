load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "testutil",
    srcs = [
        "expect.go",
        "mocks.go",
        "session.go",
        "tls.go",
        "tmux.go",
        "wait.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/testutil",
    visibility = ["//visibility:public"],
    deps = [
        "//executor",
        "//executor/safeexec",
        "//session/instance",
