load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "scoping_lib",
    srcs = [
        "golist.go",
        "main.go",
        "model.go",
        "replay.go",
        "t9.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/scoping",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "scoping",
    embed = [":scoping_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "scoping_test",
    srcs = ["scoping_test.go"],
    embed = [":scoping_lib"],
)
