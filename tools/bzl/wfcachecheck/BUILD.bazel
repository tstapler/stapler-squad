load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "wfcachecheck_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/wfcachecheck",
    visibility = ["//visibility:private"],
    deps = ["@in_gopkg_yaml_v3//:yaml_v3"],
)

go_binary(
    name = "wfcachecheck",
    embed = [":wfcachecheck_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "wfcachecheck_test",
    srcs = ["main_test.go"],
    data = glob(["testdata/**"]),  # keep
    embed = [":wfcachecheck_lib"],
)
