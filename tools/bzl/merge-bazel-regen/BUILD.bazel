load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "merge-bazel-regen_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/merge-bazel-regen",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "merge-bazel-regen",
    embed = [":merge-bazel-regen_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "merge-bazel-regen_test",
    srcs = ["main_test.go"],
    embed = [":merge-bazel-regen_lib"],
)
