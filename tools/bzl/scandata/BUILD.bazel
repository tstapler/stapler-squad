load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "scandata_lib",
    srcs = [
        "consumers.go",
        "leaves.go",
        "main.go",
        "module.go",
        "nobuild.go",
        "parse.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/scandata",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "scandata",
    embed = [":scandata_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "scandata_test",
    srcs = [
        "fix_test.go",
        "main_test.go",
    ],
    embed = [":scandata_lib"],
    deps = ["@com_github_stretchr_testify//require"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)

