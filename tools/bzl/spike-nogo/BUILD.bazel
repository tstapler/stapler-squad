# gazelle:exclude clean
# gazelle:exclude seed
load("@rules_go//go:def.bzl", "go_library", "nogo")

# Spike S12: the analyzer comes from the isolated tools/lint module (@lint_x_tools universe).
nogo(
    name = "nogo",
    config = "nogo_config.json",
    visibility = ["//visibility:public"],
    deps = [":norawgitcli_rootdeps"],
)

go_library(
    name = "clean",
    srcs = ["clean/clean.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/spike-nogo/clean",
    visibility = ["//visibility:public"],
)

go_library(
    name = "seed",
    srcs = ["seed/seed.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/spike-nogo/seed",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

# Same analyzer source, compiled against the ROOT x/tools universe. nogo itself links the root
# x/tools; linking the isolated @lint_x_tools copy too fails with "package conflict error:
# multiple copies of package passed to linker" (first attempt, recorded in spike-results.md).
go_library(
    name = "norawgitcli_rootdeps",
    srcs = ["//tools/lint/norawgitcli:analyzer.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/lint/norawgitcli",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_x_tools//go/analysis",
        "@org_golang_x_tools//go/analysis/passes/inspect",
        "@org_golang_x_tools//go/ast/inspector",
    ],
)
