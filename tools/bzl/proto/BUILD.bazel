# Spike S1 (Story 0.3, Task 0.3a): connect-go as a rules_go proto compiler.
load("@rules_go//proto:compiler.bzl", "go_proto_compiler")

alias(
    name = "protoc_gen_connect_go",
    actual = "@com_connectrpc_connect//cmd/protoc-gen-connect-go",
    visibility = ["//visibility:public"],
)

go_proto_compiler(
    name = "connect_go",
    options = ["paths=source_relative"],
    plugin = ":protoc_gen_connect_go",
    suffix = ".connect.go",
    visibility = ["//visibility:public"],
    deps = ["@com_connectrpc_connect//:connect"],
)
