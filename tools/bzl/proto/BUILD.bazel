# Spike S1 (Story 0.3, Task 0.3a): connect-go as a rules_go proto compiler.
load("@rules_go//proto:compiler.bzl", "go_proto_compiler")
load("//tools/bzl/proto:ts.bzl", "buf_gen_ts")

alias(
    name = "protoc_gen_connect_go",
    actual = "@com_connectrpc_connect//cmd/protoc-gen-connect-go",
    visibility = ["//visibility:public"],
)

go_proto_compiler(
    name = "connect_go",
    options = ["paths=source_relative"],
    plugin = ":protoc_gen_connect_go",
    suffix = ".connect.go",
    visibility = ["//visibility:public"],
    deps = ["@com_connectrpc_connect//:connect"],
)

# Spike S1-ts (Task 0.6e): web-app/src/gen as a tree artifact, protoc-gen-es from @web_node_modules.
buf_gen_ts(
    name = "gen_ts",
    srcs = ["//proto/session/v1:protos"],
    buf = "@com_github_bufbuild_buf//cmd/buf",
    buf_yaml = "//:buf.yaml",
    node = "@node_linux_x64//:bin/node",
    node_modules = "@web_node_modules//:node_modules",
    template = "//:buf.gen.bazel-ts.yaml",
    visibility = ["//visibility:public"],
)
