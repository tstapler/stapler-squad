load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "improvement_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/parity/improvement",
    visibility = ["//visibility:private"],
    deps = [
        "//tools/bzl/parity/collect",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "improvement",
    embed = [":improvement_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "improvement_test",
    srcs = ["main_test.go"],
    embed = [":improvement_lib"],
)
