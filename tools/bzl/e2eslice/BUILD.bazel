load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "e2eslice_lib",
    srcs = [
        "completeness.go",
        "fine.go",
        "gen.go",
        "graph.go",
        "main.go",
        "manifest.go",
        "quarantine.go",
        "registry.go",
        "replay.go",
        "selector.go",
        "slowsuites.go",
