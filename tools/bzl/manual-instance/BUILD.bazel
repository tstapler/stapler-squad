load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "manual-instance_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/manual-instance",
    visibility = ["//visibility:private"],
