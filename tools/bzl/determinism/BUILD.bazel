load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "determinism_lib",
    srcs = [
        "determinism.go",
        "main.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/determinism",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "determinism",
    embed = [":determinism_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "determinism_test",
    srcs = ["determinism_test.go"],
    embed = [":determinism_lib"],
)
