load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "e2ecapture_lib",
    srcs = [
        "fine.go",
        "main.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tools/bzl/e2ecapture",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "e2ecapture",
    embed = [":e2ecapture_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "e2ecapture_test",
    srcs = ["main_test.go"],
    embed = [":e2ecapture_lib"],
)
