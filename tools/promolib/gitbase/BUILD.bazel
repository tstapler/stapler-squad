load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "gitbase",
    srcs = ["gitbase.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/promolib/gitbase",
    visibility = ["//visibility:public"],
    deps = [
        "//session/git",
        "@com_github_go_git_go_git_v5//:go-git",
        "@com_github_go_git_go_git_v5//plumbing",
        "@com_github_go_git_go_git_v5//plumbing/filemode",
        "@com_github_go_git_go_git_v5//plumbing/object",
        "@com_github_go_git_go_git_v5//utils/merkletrie",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gitbase",
    visibility = ["//visibility:public"],
)

go_test(
    name = "gitbase_test",
    srcs = ["gitbase_test.go"],
    deps = [
        ":gitbase",
        "//tools/promolib/gitbase/gitbasetest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
