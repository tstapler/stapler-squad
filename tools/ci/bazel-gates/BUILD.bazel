load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "bazel-gates_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/ci/bazel-gates",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "bazel-gates",
    embed = [":bazel-gates_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bazel-gates_test",
    srcs = ["main_test.go"],
    embed = [":bazel-gates_lib"],
)
