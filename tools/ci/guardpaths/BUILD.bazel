load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "guardpaths",
    srcs = ["guardpaths.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/ci/guardpaths",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":guardpaths",
    visibility = ["//visibility:public"],
)

go_test(
    name = "guardpaths_test",
    srcs = ["guardpaths_test.go"],
    data = [
        "//:go.mod",
        "//session:go_sources",
        "//session/autonomous:go_sources",
        "//session/driver:go_sources",
        "//session/instance:go_sources",
        "//session/unfinished:go_sources",
        "//session/vc:go_sources",
        "//tools/bzl:go_test.bzl",
        "//tools/bzl/scandata:module_go_sources",
    ],
    embed = [":guardpaths"],
    deps = ["//internal/reporoot"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
