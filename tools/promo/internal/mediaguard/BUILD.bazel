    name = "go_default_library",
    actual = ":mediaguard",
    visibility = ["//tools/promo:__subpackages__"],
)

go_test(
    name = "mediaguard_test",
    srcs = ["mediaguard_test.go"],
    deps = [
        ":mediaguard",
        "//tools/promo/internal/codeowners",
        "//tools/promolib/gitbase/gitbasetest",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
