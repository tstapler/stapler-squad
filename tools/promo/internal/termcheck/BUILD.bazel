    visibility = ["//tools/promo:__subpackages__"],
)

go_test(
    name = "termcheck_test",
    srcs = ["termcheck_test.go"],
    deps = [
        ":termcheck",
        "//tools/promolib/gitbase",
        "//tools/promolib/gitbase/gitbasetest",
        "//tools/promolib/termscan",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
