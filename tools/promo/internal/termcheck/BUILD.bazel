load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "termcheck",
    srcs = [
        "media.go",
        "termcheck.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/tools/promo/internal/termcheck",
    visibility = ["//tools/promo:__subpackages__"],
    deps = [
        "//tools/promo/internal/manifest",
        "//tools/promolib/gitbase",
        "//tools/promolib/termscan",
