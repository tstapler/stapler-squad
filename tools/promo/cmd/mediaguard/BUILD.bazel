load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "mediaguard_lib",
    srcs = ["main.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/promo/cmd/mediaguard",
    visibility = ["//visibility:private"],
    deps = ["//tools/promo/internal/mediaguard"],
)

go_binary(
    name = "mediaguard",
    embed = [":mediaguard_lib"],
    visibility = ["//visibility:public"],
)

# Read by the module-walking guard tests via //tools/bzl/scandata:module_go_sources.
filegroup(
    name = "go_sources",
    srcs = glob(["*.go"]),
    visibility = ["//tools/bzl/scandata:__pkg__"],
)
