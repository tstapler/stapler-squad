load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

exports_files(["analyzer.go"])

go_library(
    name = "nosessiondrivertest",
    srcs = ["analyzer.go"],
    importpath = "github.com/tstapler/stapler-squad/tools/lint/nosessiondrivertest",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/lint/internal/nolintcomment",
        "@lint_x_tools//go/analysis",
    ],
)

alias(
    name = "go_default_library",
    actual = ":nosessiondrivertest",
    visibility = ["//visibility:public"],
)

go_test(
    name = "nosessiondrivertest_test",
    srcs = [
        "analyzer_test.go",
        "export_test.go",
    ],
    data = glob(["testdata/**"]) + ["@rules_go//go"],
    embed = [":nosessiondrivertest"],
    # keep: gazelle adds the embedded library as a dep, which rules_go rejects as a duplicate link.
    deps = [
        "//tools/lint/internal/gotool",
        "@lint_x_tools//go/analysis/analysistest",
    ],
)
