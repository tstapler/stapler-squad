alias(
    name = "go_default_library",
    actual = ":resolve",
    visibility = ["//tools/docscoverage:__subpackages__"],
)

go_test(
    name = "resolve_test",
    srcs = ["resolve_test.go"],
    deps = [
        ":resolve",
        "//tools/docscoverage/internal/fixture",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
