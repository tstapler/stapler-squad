module(
    name = "stapler_squad",
    version = "0.0.0",
)

# Pins: project_plans/bazel-conversion/research/stack.md section 1.
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_lib", version = "3.7.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# One nogo for the whole repo (Story 8.4): the twins of every tools/lint analyzer, scoped by tools/bzl/nogo/nogo_config.json.
go_sdk.nogo(nogo = "//tools/bzl/nogo:nogo")

# Root module universe. The go.mod `replace` for go-git is honoured here (root module only).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "cc_mvdan_sh_v3", "com_connectrpc_connect", "com_connectrpc_otelconnect", "com_github_atotto_clipboard", "com_github_bmatcuk_doublestar_v4", "com_github_bufbuild_buf", "com_github_bufbuild_connect_go", "com_github_creack_pty", "com_github_data_dog_go_sqlmock", "com_github_ebitengine_purego", "com_github_edsrzf_mmap_go", "com_github_fsnotify_fsnotify", "com_github_gliderlabs_ssh", "com_github_go_git_gcfg", "com_github_go_git_go_billy_v5", "com_github_go_git_go_git_v5", "com_github_go_webauthn_webauthn", "com_github_gofrs_flock", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_grafana_pyroscope_go", "com_github_grafana_pyroscope_go_godeltaprof", "com_github_klauspost_compress", "com_github_linkdata_deadlock", "com_github_mark3labs_mcp_go", "com_github_netflix_go_expect", "com_github_oklog_ulid_v2", "com_github_pelletier_go_toml_v2", "com_github_puzpuzpuz_xsync_v4", "com_github_robfig_cron_v3", "com_github_sergi_go_diff", "com_github_sherclockholmes_webpush_go", "com_github_shirou_gopsutil_v4", "com_github_skip2_go_qrcode", "com_github_spaolacci_murmur3", "com_github_spf13_cobra", "com_github_stretchr_testify", "com_github_tstapler_tymux_clients_go", "com_github_xeipuuv_gojsonschema", "com_github_zalando_go_keyring", "com_tailscale", "in_gopkg_natefinch_lumberjack_v2", "in_gopkg_yaml_v3", "io_entgo_ent", "io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "io_opentelemetry_go_otelc_pkg", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_mod", "org_golang_x_net", "org_golang_x_sync", "org_golang_x_sys", "org_golang_x_term", "org_golang_x_text", "org_golang_x_time", "org_golang_x_tools", "org_modernc_sqlite", "org_uber_go_goleak")

# tools/lint keeps its own dependency universe so analyzer deps never bump app versions.
lint_go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", isolate = True)
lint_go_deps.from_file(go_mod = "//tools/lint:go.mod")
use_repo(lint_go_deps, lint_x_tools = "org_golang_x_tools")

# --- S5 (tmux, Story 0.7): hermetic tmux from the release tarball, never the submodule. ---
# Pin lives in tools/bzl/tmux/PIN; the sha256 here must equal it.
bazel_dep(name = "rules_foreign_cc", version = "0.17.0")
bazel_dep(name = "libevent", version = "2.1.12-stable.bcr.0")
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.15")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "tmux_src",
    build_file_content = """filegroup(name = "all_srcs", srcs = glob(["**"]), visibility = ["//visibility:public"])""",
    sha256 = "e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e",
    strip_prefix = "tmux-3.8",
    urls = ["https://github.com/tmux/tmux/releases/download/3.8/tmux-3.8.tar.gz"],
)

