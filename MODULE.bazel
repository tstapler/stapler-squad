module(
    name = "stapler_squad",
    version = "0.0.0",
)

# Pins: project_plans/bazel-conversion/research/stack.md section 1.
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_lib", version = "3.7.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Root module universe. The go.mod `replace` for go-git is honoured here (root module only).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# tuitest (own go.mod) imports only modules already in the root go.mod; it joins this
# universe without a second from_file tag (one per module is allowed).
use_repo(go_deps, "cc_mvdan_sh_v3", "com_connectrpc_connect", "com_connectrpc_otelconnect", "com_github_atotto_clipboard", "com_github_bmatcuk_doublestar_v4", "com_github_bufbuild_buf", "com_github_bufbuild_connect_go", "com_github_creack_pty", "com_github_data_dog_go_sqlmock", "com_github_ebitengine_purego", "com_github_edsrzf_mmap_go", "com_github_fsnotify_fsnotify", "com_github_gliderlabs_ssh", "com_github_go_git_gcfg", "com_github_go_git_go_billy_v5", "com_github_go_git_go_git_v5", "com_github_go_webauthn_webauthn", "com_github_gofrs_flock", "com_github_google_uuid", "com_github_gorilla_websocket", "com_github_grafana_pyroscope_go", "com_github_grafana_pyroscope_go_godeltaprof", "com_github_klauspost_compress", "com_github_linkdata_deadlock", "com_github_mark3labs_mcp_go", "com_github_mattn_go_sqlite3", "com_github_netflix_go_expect", "com_github_oklog_ulid_v2", "com_github_pelletier_go_toml_v2", "com_github_puzpuzpuz_xsync_v4", "com_github_robfig_cron_v3", "com_github_sergi_go_diff", "com_github_sherclockholmes_webpush_go", "com_github_shirou_gopsutil_v4", "com_github_skip2_go_qrcode", "com_github_spaolacci_murmur3", "com_github_spf13_cobra", "com_github_stretchr_testify", "com_github_tstapler_tymux_clients_go", "com_github_xeipuuv_gojsonschema", "com_github_zalando_go_keyring", "com_tailscale", "in_gopkg_natefinch_lumberjack_v2", "in_gopkg_yaml_v3", "io_entgo_ent", "io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetricgrpc", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracegrpc", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "io_opentelemetry_go_otelc_pkg", "org_golang_google_protobuf", "org_golang_x_crypto", "org_golang_x_mod", "org_golang_x_net", "org_golang_x_sync", "org_golang_x_sys", "org_golang_x_term", "org_golang_x_text", "org_golang_x_time", "org_golang_x_tools", "org_modernc_sqlite", "org_uber_go_goleak")

# tools/lint keeps its own dependency universe so analyzer deps never bump app versions.
lint_go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", isolate = True)
lint_go_deps.from_file(go_mod = "//tools/lint:go.mod")
use_repo(lint_go_deps, lint_x_tools = "org_golang_x_tools")

# Spike S4 (Story 0.6): pinned Bun + Node and a repository rule that runs `bun install --frozen-lockfile`.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "bun_linux_x64",
    build_file_content = 'exports_files(["bun-linux-x64/bun"])',
    sha256 = "3e730528d89775f03f87f05c06787c4df4099d0a37f3f252e7b829cb23816e18",
    urls = ["https://github.com/oven-sh/bun/releases/download/bun-v1.4.3/bun-linux-x64.zip"],
)

http_archive(
    name = "node_linux_x64",
    build_file_content = 'exports_files(["bin/node"])',
    sha256 = "30215f90ea3cd04dfbc06e762c021393fa173a1d392974298bbc871a8e461089",
    strip_prefix = "node-v24.13.1-linux-x64",
    urls = ["https://nodejs.org/dist/v24.13.1/node-v24.13.1-linux-x64.tar.xz"],
)

bun_install = use_repo_rule("//tools/bzl/bun:bun.bzl", "bun_install")

bun_install(
    name = "web_node_modules",
    bun = "@bun_linux_x64//:bun-linux-x64/bun",
    bun_lock = "//web-app:bun.lock",
    bun_version = "1.4.3",
    bunfig = "//web-app:bunfig.toml",
    files = [
        "//web-app:eslint-plugin-analytics/index.js",
        "//web-app:eslint-plugin-analytics/package.json",
        "//web-app:eslint-plugin-analytics/rules/__tests__/no-direct-files-track.test.js",
        "//web-app:eslint-plugin-analytics/rules/__tests__/require-omnibar-dispatch.test.js",
        "//web-app:eslint-plugin-analytics/rules/__tests__/require-on-click.test.js",
        "//web-app:eslint-plugin-analytics/rules/__tests__/require-page-analytics.test.js",
        "//web-app:eslint-plugin-analytics/rules/__tests__/require-rpc-analytics.test.js",
        "//web-app:eslint-plugin-analytics/rules/no-direct-files-track.js",
        "//web-app:eslint-plugin-analytics/rules/require-omnibar-dispatch.js",
        "//web-app:eslint-plugin-analytics/rules/require-on-click.js",
        "//web-app:eslint-plugin-analytics/rules/require-page-analytics.js",
        "//web-app:eslint-plugin-analytics/rules/require-rpc-analytics.js",
        "//web-app:eslint-plugin-rpc-lifecycle/index.js",
        "//web-app:eslint-plugin-rpc-lifecycle/package.json",
        "//web-app:eslint-plugin-rpc-lifecycle/rules/require-abort-signal.js",
        "//web-app:patches/eval@0.1.8.patch",
    ],
    node = "@node_linux_x64//:bin/node",
    package_json = "//web-app:package.json",
)
