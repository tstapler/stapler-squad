load("@rules_go//go:def.bzl", "go_library")
load("//tools/bzl:go_test.bzl", "go_test")

go_library(
    name = "commands",
    srcs = [
        "client.go",
        "create_session.go",
        "ensure_ports_free.go",
        "get_diff.go",
        "get_session.go",
        "list_sessions.go",
        "steer.go",
    ],
    importpath = "github.com/tstapler/stapler-squad/cmd/commands",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/portguard",
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "@com_connectrpc_connect//:connect",
        "@com_github_spf13_cobra//:cobra",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

alias(
    name = "go_default_library",
    actual = ":commands",
    visibility = ["//visibility:public"],
)

go_test(
    name = "commands_test",
    srcs = ["commands_test.go"],
    embed = [":commands"],
    deps = [
        "//proto/session/v1:sessionv1_go",
        "//proto/session/v1:sessionv1connect_go",
        "@com_connectrpc_connect//:connect",
        "@com_github_spf13_cobra//:cobra",
    ],
